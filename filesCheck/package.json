{
  "name": "filesCheck",
  "version": "1.0.0",
  "description": "Script that checks consistency of files expected by sBots",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benkio/sBots.git"
  },
  "keywords": [
    "id3v2",
    "tags",
    "mp3",
    "mp4",
    "mediainfo"
  ],
  "author": "Enrico Benini (Benkio)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/benkio/sBots/issues"
  },
  "homepage": "https://github.com/benkio/sBots#readme",
  "dependencies": {
    "@effect/platform-node": "^4.0.4",
    "effect": "^4.0.4",
    "gts": "^7.0.0",
    "mediainfo-parser": "^1.1.5",
    "node-id3": "^0.2.9",
    "read-package-up": "^12.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "gts": "^7.0.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "lint": "gts lint",
    "check": "prettier . --check",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "format": "prettier . --write",
    "prepare": "npm run compile",
    "test": "node --test --import tsx test/*.ts",
    "pretest": "npm run compile",
    "posttest": "npm run lint",
    "start": "tsx ./src/index.ts",
    "validate": "npm run compile && npm run format && npm run fix && npm run lint",
    "watch": "tsc -w"
  }
}
