{
  "name": "filesCheck",
  "version": "1.0.0",
  "description": "Script that checks consistency of files expected by sBots",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benkio/sBots.git"
  },
  "keywords": [
    "id3v2",
    "tags",
    "mp3",
    "mp4",
    "mediainfo"
  ],
  "author": "Enrico Benini (Benkio)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/benkio/sBots/issues"
  },
  "homepage": "https://github.com/benkio/sBots#readme",
  "dependencies": {
    "@effect/platform-node": "^4.0.4",
    "effect": "^4.0.4",
    "mediainfo-parser": "^1.1.5",
    "node-id3": "^0.2.9",
    "read-package-up": "^12.0.0",
    "tg-markdown-converter": "^1.1.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "prettier": "3.9.10",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "lint": "eslint .",
    "check": "prettier . --check && eslint .",
    "compile": "tsc6",
    "fix": "eslint . --fix",
    "format": "prettier . --write",
    "test": "node --test --import tsx test/*.ts",
    "start": "tsx ./src/index.ts",
    "validate": "npm run compile && npm run format && npm run fix && npm run lint",
    "watch": "tsc6 -w"
  }
}
