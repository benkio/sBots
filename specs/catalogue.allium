-- allium: 3
-- catalogue.allium: the offline job (modules/botDB) that loads each bot's media and show catalogues into the bot store.
-- Excludes: schema migration, DB transactor, YouTube request shapes, logging.

use "./sbots.allium" as core

external entity MediaListFile {
    bot: core/Bot
    parsable: Boolean                -- false when the list file is not valid json for the entries
    entries: List<MediaListEntry>
}

-- The sticker kind is Telegram only; its persisted key stays "sticker".
value MediaListEntry {
    filename: String
    kind: mp3 | gif | photo | video | document | sticker | markdown
    kinds: Set<String>
    sources: List<String>
}

-- a show as stored in a source's catalogue file
external entity ShowFileEntry {
    file: String                    -- the ShowSource.catalogue_file it is read from
    id: String
    title: String
    uploaded_at: Timestamp
    duration: Duration
    description: String?
    is_live: Boolean
}

-- a local caption file `<folder>/<video id>.<language>.srt`, parsed into plain and timed text
external entity CaptionFile {
    source: ShowSource
    folder: String                  -- the ShowSource.caption_folder it lives in
    language: String                -- the ShowSource.caption_language
    video_id: String
    text: String?
    timed: List<Caption>
}

-- a video as listed by the YouTube API
external entity YouTubeVideo {
    id: String
    source: ShowSource
    title: String?
    published_at: Timestamp?
    duration: Duration?
    description: String?
    is_live: Boolean
}

external entity ShowSource {
    bot: core/Bot
    youtube_sources: List<String>   -- "@handle" is a channel, anything else a playlist id
    caption_language: String
    catalogue_file: String
    caption_folder: String
}

value Caption {
    at: Duration
    text: String
}

entity Show {
    id: String                      -- YouTube video id, unique within a catalogue file
    bot: core/Bot
    title: String
    uploaded_at: Timestamp
    duration: Duration
    description: String?
    is_live: Boolean
    source: ShowSource
    caption_text: String?
    caption_timed: List<Caption>
    -- the video has a caption in the source's caption_language (asked to the caption tool, per stored or new show)
    has_caption: Boolean
}

entity CatalogueRun {
    status: migrating | loading_media | loading_shows | done | failed

    transitions status {
        migrating -> loading_media
        loading_media -> loading_shows
        loading_shows -> done
        loading_media -> failed
        loading_shows -> failed
        terminal: done, failed
    }
}

config {
    run_show_fetching: Boolean = false
    run_show_caption_fetching: Boolean = false
    caption_tool_available: Boolean = true   -- yt-dlp found on the PATH
    caption_cookies_file: Boolean = false    -- optional youTubeCookies.txt in the botDB resources, given to every yt-dlp call
    caption_throttle: Duration = 5.seconds   -- random 5 to 9 s between caption downloads
}

surface CatalogueConsole {
    facing _: core/Operator

    provides:
        OperatorRunsCatalogue()
}

rule CatalogueRunStarts {
    when: OperatorRunsCatalogue()
    -- the store schema is brought up to date first
    ensures: CatalogueRun.created(status: migrating)
}

rule MigrationDone {
    when: run: CatalogueRun.created
    requires: run.status = migrating
    ensures: run.status = loading_media
}

rule MediaCatalogueLoaded {
    when: run: CatalogueRun.status transitions_to loading_media
    requires: not exists MediaListFile{parsable: false}
    ensures:
        for f in MediaListFile:
            for e in f.entries:
                core/MediaFile.created(bot: f.bot, name: e.filename, kind: e.kind, kinds: e.kinds,
                                       sources: e.sources, platform_file_ids: {}, send_count: 0)
    ensures: run.status = loading_shows
}

-- a re-run does not reset the send count of an existing media: the insert of a new row starts at 0, but the conflict path
-- only refreshes its kinds and sources, and only a successful send increments the count.

-- the run needs the YouTube API token even when it only reads files; config load and DB connection happen before migration
-- and a failure there, like a migration failure, crashes the process and is not a modelled transition. This is treated as
-- a job prerequisite, though it is stricter than the file-only path needs.
-- an unparsable list file fails the whole run
rule MediaCatalogueFails {
    when: run: CatalogueRun.status transitions_to loading_media
    requires: exists MediaListFile{parsable: false}
    ensures: run.status = failed
}

-- a full rebuild is performed by emptying every source's show catalogue file before the run, not by a config flag:
-- with fetching on, all listed videos are then inserted and the files rewritten; with fetching off, nothing is loaded.
-- The .srt caption files are never deleted by the job: existing captions are reused and only missing ones are
-- downloaded, so a caption rebuild requires a separate manual cleanup of those files.
rule ShowsLoadedFromCatalogueFiles {
    when: run: CatalogueRun.status transitions_to loading_shows
    requires: not config.run_show_fetching
    ensures:
        for src in ShowSource:
            for e in ShowFileEntry where e.file = src.catalogue_file:
                Show.created(id: e.id, bot: src.bot, source: src, title: e.title, uploaded_at: e.uploaded_at,
                             duration: e.duration, description: e.description, is_live: e.is_live,
                             caption_text: null, caption_timed: [], has_caption: false)
    ensures: run.status = done
}

rule ShowsRefreshedFromYouTube {
    when: run: CatalogueRun.status transitions_to loading_shows
    requires: config.run_show_fetching
    -- the caption tool is checked after the videos are listed, only when both fetching flags are on; a missing tool aborts
    -- before anything is stored or written
    requires: not (config.run_show_caption_fetching and not config.caption_tool_available)
    -- a YouTube video id is globally unique, so ids not yet stored (across all sources) become Shows, incomplete videos are skipped, the catalogue file is
    -- rewritten sorted by id; if YouTube cannot be listed only the stored shows are kept
    ensures:
        -- a source without YouTube sources (channel "@handle" or playlist id) lists no videos
        for src in ShowSource where src.youtube_sources.count > 0:
            for v in YouTubeVideo where v.source = src and v.title != null and v.published_at != null
                    and v.duration != null and not exists Show{id: v.id}:
                Show.created(id: v.id, bot: src.bot, source: src, title: v.title, uploaded_at: v.published_at,
                             duration: v.duration, description: v.description, is_live: v.is_live,
                             caption_text: null, caption_timed: [], has_caption: false)
    ensures: CaptionsRequested(run: run)
    ensures: run.status = done
}

-- captions are downloaded only on the YouTube refresh path: the file-only path never fetches, but both paths parse the
-- local caption file into the show. Setting run_show_caption_fetching on a file-only run is therefore a no-op.
-- a caption is downloaded (with a throttle between downloads) for each show that YouTube lists a caption for and that has
-- no local caption file yet; a failed download is logged and skipped
rule CaptionsFetched {
    when: CaptionsRequested(run)
    requires: config.run_show_caption_fetching
    ensures:
        for sh in Shows where sh.has_caption and not exists CaptionFile{source: sh.source, video_id: sh.id}:
            CaptionFile.created(source: sh.source, folder: sh.source.caption_folder,
                                language: sh.source.caption_language, video_id: sh.id, text: null, timed: [])
}

-- at the end of both paths each show takes its caption from its local caption file, when there is one
rule ShowCaptionsParsed {
    when: run: CatalogueRun.status transitions_to done
    ensures:
        for sh in Shows:
            for f in CaptionFiles where f.source = sh.source and f.video_id = sh.id
                    and f.language = sh.source.caption_language:
                sh.caption_text = f.text
                sh.caption_timed = f.timed
}

rule CatalogueFailsWithoutCaptionTool {
    when: run: CatalogueRun.status transitions_to loading_shows
    requires: config.run_show_fetching and config.run_show_caption_fetching and not config.caption_tool_available
    ensures: run.status = failed
}

invariant ShowIdsUniquePerCatalogue {
    for a in Shows:
        for b in Shows:
            a != b and a.bot = b.bot implies a.id != b.id
}

-- Captions are listed and downloaded only through the caption tool (yt-dlp); the YouTube API client builds no
-- captions.list/captions.download requests.
