-- allium: 3
-- engine-extras.allium: chatCore behaviour that sbots.allium does not cover yet: per-chat timeout, subscriptions,
-- media usage, operator notification throttling. Corrections to sbots.allium itself are not made here.

use "./sbots.allium" as core

config {
    subscription_min_interval: Duration = 1.minute
    max_subscriptions_per_chat: Integer = 50
    max_subscription_target_length: Integer = 200
    top_media_count: Integer = 20
    auto_timeout_per_doubling: Duration = 5.seconds
    paged_list_page_size: Integer = 5
    paged_list_action_id_max_length: Integer = 100    -- the limit of a Discord button id
}

-- The bot is added to a group chat: raised by the Telegram and Discord adapters (IRC has no such event).
-- member_count includes every member, bots and the bot itself.
-- Scenario: 2 members -> 5s, 10 -> 17s, 100 -> 33s, 1000 -> 50s, 10000 -> 66s.
rule BotJoinsChatSetsAutoTimeout {
    when: BotJoinsChat(chat, bot, member_count)
    requires: not chat.is_private
    -- the count is a snapshot taken on joining and never refreshed, /settimeout is the way to change it later
    -- an existing row (manual or from a previous stay) is replaced, as the bot was removed from the chat in between
    -- if the platform gives no member count no row is created
    -- the clock starts at the join, the welcome reply does not move it (see PostComputationLogsInteraction)
    ensures: core/ChatTimeout.created(
        chat: chat,
        bot: bot,
        reply_timeout: AutoTimeoutFor(member_count: member_count),
        last_interaction: now
    )
}

-- AutoTimeoutFor(member_count) = max(1.second, auto_timeout_per_doubling * log2(member_count)), rounded to whole seconds:
-- logarithmic, so a big chat is slowed more than a small one but never in proportion to its size.

rule UserSetsTimeout {
    when: UserSetsTimeout(chat, bot, value)       -- "/settimeout hh:mm:ss", a malformed value only gets an error text
    requires: value > 0.seconds
    ensures: core/ChatTimeout.created(chat: chat, bot: bot, reply_timeout: value, last_interaction: now)
}

rule UserRemovesTimeout {
    when: UserRemovesTimeout(chat, bot)           -- "/settimeout" with an empty value
    requires: exists core/ChatTimeout{chat: chat, bot: bot}
    ensures: not exists core/ChatTimeout{chat: chat, bot: bot}
}

actor ChatUser {
    identified_by: ChatUser where true
}

surface ChatCommands {
    facing _: ChatUser

    provides:
        UserSetsTimeout(chat, bot, value)
        UserRemovesTimeout(chat, bot)
        UserSubscribes(chat, bot, schedule, type, target)
        UserLoadsCalendar(chat, bot)
        UserUnsubscribes(chat, bot, selector)
        UserSearchesTriggers(chat, bot, input)
}

enum SubscriptionType { show | trigger | calendar }

entity Subscription {
    chat: core/Chat
    bot: core/Bot
    type: SubscriptionType
    target: String?
    schedule: String          -- six-field cron
    subscribed_at: Timestamp
    next_fire_at: Timestamp   -- the next occurrence of the schedule
}

rule UserSubscribes {
    when: UserSubscribes(chat, bot, schedule, type, target)   -- "/subscribe <cron> [type [target]]", no type means show
    requires: type = show or type = trigger                   -- calendar only through /loadcalendar
    requires: target = null or target.length <= config.max_subscription_target_length
    -- a trigger subscription without a target needs the bot to have message replies; with a target, the target must
    -- match a bundle (even if the bot has replies)
    -- the shortest gap between occurrences of the schedule is at least config.subscription_min_interval
    requires: ScheduleGapAtLeast(schedule: schedule, gap: config.subscription_min_interval)
    requires: (Subscriptions where chat = chat and bot = bot).count < config.max_subscriptions_per_chat
    ensures: Subscription.created(chat: chat, bot: bot, type: type, target: target, schedule: schedule, subscribed_at: now, next_fire_at: NextOccurrence(schedule, now))
}

rule UserLoadsCalendar {
    when: UserLoadsCalendar(chat, bot)
    requires: bot.has_calendar_candidates
    requires: not exists Subscription{chat: chat, bot: bot, type: calendar}
    requires: (Subscriptions where chat = chat and bot = bot).count < config.max_subscriptions_per_chat
    ensures: Subscription.created(chat: chat, bot: bot, type: calendar, target: null, schedule: "0 0 9 * * ?", subscribed_at: now,
                                next_fire_at: NextOccurrence("0 0 9 * * ?", now))
}

-- an id of a subscription that does not belong to the calling chat (or is not loaded on this platform) is not found and
-- nothing is cancelled
rule UserUnsubscribes {
    when: UserUnsubscribes(chat, bot, selector)               -- empty selector = all, an id = that one, else a type
    ensures:
        for s in Subscriptions where s.chat = chat and s.bot = bot and SelectorMatches(selector, s):
            not exists s
}

-- a trigger subscription only matches a bundle: no timeout, ignore prefix, forward or age filter, no post computation;
-- a calendar subscription replies only when today has shows
rule SubscriptionFires {
    when: s: Subscription.next_fire_at <= now
    -- a trigger subscription without a target sends the reply of a random bundle; show and calendar replies are sent as
    -- replies to a message, trigger replies are not
    ensures: core/Reply.sent(chat: s.chat, reply: SubscriptionReply(s))
    ensures: s.next_fire_at = NextOccurrence(s.schedule, now)
}

-- the outcome of building and sending a subscription reply
external entity SubscriptionFireAttempt {
    subscription: Subscription
    failed: Boolean
}

rule SubscriptionFireFails {
    when: attempt: SubscriptionFireAttempt.failed = true
    -- the schedule keeps running: next_fire_at advances in SubscriptionFires either way
    ensures: core/OperatorsNotified(bot: attempt.subscription.bot, reason: subscription_failed)
}

-- /triggersearch <input> lists the bundles whose trigger matches the input.
rule UserSearchesTriggers {
    when: UserSearchesTriggers(chat, bot, input)
    ensures: core/Reply.sent(chat: chat, reply: TriggerSearchResult(bot, input))
}

-- counted once the file reached the chat: a failed send is not counted, nor is a file that is too big to be uploaded and
-- is sent as a link instead
rule MediaSentCounted {
    when: core/Reply.sent(chat, reply)
    requires: reply.delivery = media_file
    ensures:
        for media in reply.media:
            media.send_count = media.send_count + 1
}

-- Paged command lists (shows, triggers, top twenty) show paged_list_page_size items per page.
-- What happens when the user acts on a list is platform neutral (PagedListNavigation in chatCore, no platform type in it):
-- an adapter only turns a button press (Telegram, later Discord and Slack) or a typed command (IRC and Twitch, later)
-- into a PagedListAction and sends back the replies. The action has an id (toId / fromId) of at most
-- paged_list_action_id_max_length characters; the id of an action decodes to the same action (round trip).
value PagedListAction {
    kind: next_page | previous_page | pick_media | pick_show
    command: String         -- the command that produced the list, run again for another page
    page: Integer           -- the page the user was looking at, from 0
    item: String?           -- the media file or the show picked, only for pick_media and pick_show
}

-- the command runs again with the new page (the same input, the same bot, no timeout or dedup of its own)
rule PagedListChangesPage {
    when: PagedListActionRequested(chat, bot, action)
    requires: action.kind = next_page or action.kind = previous_page
    -- previous at the first page stays at the first page
    ensures: PagedListShown(
        chat: chat,
        bot: bot,
        command: action.command,
        page: if action.kind = next_page: action.page + 1 else: max(action.page - 1, 0)
    )
}

-- the replies of the item picked, as if the item had been asked for directly
rule PagedListPicksItem {
    when: PagedListActionRequested(chat, bot, action)
    requires: action.kind = pick_media or action.kind = pick_show
    requires: action.item != null
    ensures: PagedListItemReplied(chat: chat, bot: bot, item: action.item)
}

-- an id that does not decode (bad format or over the length limit) is not an action: the navigation rejects it with
-- an error, no other reply is produced
rule PagedListRejectsBadId {
    when: PagedListIdReceived(chat, bot, id)
    requires: not PagedListIdDecodes(id)
    ensures: PagedListIdRejected(chat: chat, bot: bot)
}

open question "Telegram treats an undecodable callback as a media file named by the raw data (platforms.allium): does it keep that fallback or reject the id like the neutral navigation?"
-- operator notifications (window 5 minutes, error text cut to 200 characters): an error with the same (bot, context, error) is notified once per window followed by one summary;
-- infos and media errors are not throttled; a failing notification never breaks the caller

