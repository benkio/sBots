-- allium: 3
-- llm.allium: the LLM replies of the bots (epic #1499). Only what is built is specified; the rest of the epic is listed
-- as open questions. Code: modules/chatCore/llm and patterns (the ports and /llm), modules/chatLlm (the implementation
-- and its doobie repositories, the prompt builder and the responder of #1491) and modules/main (startup wiring); the
-- engine routing is still open.

use "./sbots.allium" as core

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The engine asks the responder to answer a message directed at the bot. The ports live in chatCore so the engine
-- knows nothing of the provider; the default responder never answers.
external entity LlmResponder {
    answers: Boolean    -- false for the default (noop) responder: the feature is unconfigured
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- The structured JSON object a provider returns for a completion. Only the reply text is consumed so far; the rest of
-- the payload is provider-specific and not part of the bots' observable behaviour.
value LlmReply {
    text: String                 -- empty unless the action is text
    action: text | reuse | silent   -- #1491: required; any other value is a malformed provider reply
    reply_id: String?            -- #1491: the catalogue id picked by a reuse
    -- Derived by the output guard: not empty, no line starting with / or !, no @name or <@id> mention.
    text_acceptable: Boolean
}

-- The reply the engine offers as a candidate, described to the model by its catalogue entry (id and one-line summary).
external entity CandidateReply {
    catalogue_id: String
    summary: String
    reply: String
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- The provider-agnostic client, internal to chatLlm. Whatever the provider's wire format, callers receive the same
-- decoded reply inside the completion lifecycle; the active provider is chosen by config, not by the caller.
contract LlmClient {
    complete: (prompt: String) -> Completion

    @invariant StructuredJsonOutput
        -- The reply of an answered completion is the decoded structured JSON object of the provider's response. A
        -- response that is not a valid JSON object with a reply text never produces an answered completion.

    @invariant UnexpectedErrorsReported
        -- Only a provider timeout becomes a terminal result. Any other error is reported to the operators and
        -- propagates to the caller; it is never rewritten as a completion with no attempts.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum LlmProvider { gemini | openrouter }

enum ProviderResult { success | rate_limited | server_error | timeout | rejected | malformed_json }

-- #1567: one record per provider, shared by all the bots. The limits mirror main.llm.<provider>.quota and are revisable
-- without a code change; the counters are the actual provider calls admitted by the limiter. A fallback call counts
-- against the provider that is called, never against the primary. The two sliding windows (a minute and a day) are
-- operational detail; the observable fact is when a provider's quota is exhausted.
external entity QuotaUsage {
    provider: LlmProvider
    requests_this_minute: Integer
    requests_today: Integer
    max_per_minute: Integer = 20     -- provisional for gemini (#1483 unmeasured), documented for openrouter
    max_per_day: Integer = 50
}

-- One record for the whole feature, not per provider or bot: a shared episode produces one ops message until any
-- provider has quota again.
entity QuotaNotice {
    sent: Boolean
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- #1501 / #1484: nothing changes for the bots yet. A message directed at the bot (core/Message.is_directed_at_bot) is
-- what the engine will offer to the responder; the engine does not call it yet, and the default responder never
-- answers, so the reply bundles behave as before.
--
-- #1487: the /llm ports (LlmSettings: enable, disable, status, forget) are in chatCore; their doobie repositories live
-- in chatLlm and only the port crosses back. The tables are V13 in botDB: the issue asked for V11, but V11 and V12 are
-- already applied in production and Flyway does not allow out-of-order migrations.

-- #1485: one completion per client call. The fallback is always the other provider, so a config change alone switches
-- the primary and the fallback together. #1486/#1567: a completion can also be stopped before any provider is asked:
-- `silent` for exhausted quotas, `failed` for a prompt beyond the input limit, a provider timeout or missing
-- credentials. When the primary's quota is exhausted the fallback may be asked first, so the primary label and the
-- first recorded attempt can differ.
entity Completion {
    prompt: String
    primary_provider: LlmProvider
    fallback_provider: LlmProvider = if primary_provider = gemini: openrouter else: gemini
    status: pending | answered | failed | silent
    reply: LlmReply?        -- present only when a provider returned a valid structured reply
    attempts: ProviderAttempt with completion = this

    transitions status {
        pending -> answered
        pending -> failed
        terminal: answered, failed, silent
    }
}

entity ProviderAttempt {
    completion: Completion
    provider: LlmProvider
    result: ProviderResult?     -- the provider's outcome, once it has responded
}

-- #1487: one setting per (chat, bot); the chat already carries the platform. A chat with no row is off, so enabling is
-- explicit (#1488). The updated timestamp is epoch seconds and changes on both enable and disable.
entity LlmChatSetting {
    chat: core/Chat
    bot: core/Bot
    enabled: Boolean = false
    updated_at: Timestamp
}

-- #1487/#1489: the messages kept for a chat in the shape the prompt builder will consume. A user message carries a
-- stable anonymous label in its content: the platform's sender id is salted and hashed, never shown as itself.
entity LlmContextMessage {
    chat: core/Chat
    bot: core/Bot
    role: user | assistant
    content: String
    created_at: Timestamp
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    primary_provider: LlmProvider = gemini    -- switching this value is the provider switch; no caller changes
    timeout: Duration = 10.seconds            -- one provider call is abandoned after this; the timeout is recorded as a provider result
    max_input_tokens: Integer = 4096          -- prompts larger than this (4 characters per token) are refused
    max_output_tokens: Integer = 512          -- sent to the provider as its output limit
    credentials_complete: Boolean             -- both provider keys are configured; otherwise no request is admitted

    -- #1489: the per-chat context window. The token budget uses the same four-characters-per-token estimate as the
    -- input limit, and the TTL is applied by the cron job registered from main.
    context_max_messages: Integer = 20
    context_max_tokens: Integer = 2048
    context_ttl: Duration = 7.days             -- at least one second: storage and cutoffs are epoch seconds
    context_cleanup_cron: String              -- cron expression of the cleanup job, e.g. "0 0 * ? * *"
    context_author_salt: String               -- deployment-specific secret, redacted from startup logs; no public
                                              -- default: blank and the shipped example value are rejected at startup
}

-- #1489: the context service of chatLlm. It is the boundary the engine will use for remembering a message and building
-- a prompt; the routing that calls it is still open with #1492.
contract LlmContextWindow {
    remember: (message: core/Message) -> Boolean
    prompt: (chat: core/Chat, bot: core/Bot) -> String
    delete_expired: (now: Timestamp) -> Integer

    @invariant OnlyWhileEnabled
        -- A message is remembered only for a (chat, bot) whose switch is on. A disabled chat stores nothing and a
        -- previously enabled chat stops growing as soon as it is disabled.

    @invariant BoundedWindow
        -- A prompt uses at most config.context_max_messages messages, chosen newest first until the
        -- config.context_max_tokens budget is spent (four characters per token), then kept in chronological order.
        -- The budget is estimated on the rendered prompt, including the newline separators between the messages.

    @invariant AnonymousSenders
        -- A sender appears only as a stable label derived from the platform's sender id and
        -- config.context_author_salt. The raw sender id and the platform's username or nick never reach a prompt.
        -- anonymised_content(message, salt) is that label followed by the message text (or its caption) with every
        -- mentioned name, its visible span when the platform gives mention offsets, "@nick" and Discord "<@id>"
        -- replaced by a generic label, and every line break escaped:
        -- CR, LF, U+0085, U+2028 and U+2029. User text can neither reveal a username nor forge a role-labelled line
        -- in a flat prompt. The salt is deployment-specific and secret: knowing a public default would let anyone
        -- map the labels back to senders.

    @invariant TtlPurge
        -- The cleanup job removes the messages older than config.context_ttl and keeps the newer ones, for every chat
        -- and bot. The job is registered from main on the cron scheduler of chatCore's CronBackgroundJobManager. A
        -- scheduler failure restarts the whole scheduled stream (ticks and job) and re-enters recovery on every
        -- restart, so consecutive failures still leave later ticks pruning; the scheduler fiber is owned and
        -- cancelled by main on shutdown.
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule LlmClientUsesConfiguredProvider {
    when: CompletionRequested(prompt)
    requires: config.credentials_complete
    requires: prompt.length <= config.max_input_tokens * 4
    requires: (QuotaUsage where provider = config.primary_provider).all(u => u.requests_this_minute < u.max_per_minute and u.requests_today < u.max_per_day)
    ensures:
        let completion = Completion.created(
            prompt: prompt,
            primary_provider: config.primary_provider,
            status: pending
        )
        ProviderAttempt.created(completion: completion, provider: config.primary_provider)
        ProviderRequested(completion, config.primary_provider)
}

-- An oversized prompt is refused before admission control, so it never consumes a provider's quota slot. When both
-- providers are exhausted the completion is silent (no reply of any kind), as specified by BothQuotaExhaustedSilent.
rule PromptBeyondInputLimitFails {
    when: CompletionRequested(prompt)
    requires: config.credentials_complete
    requires: prompt.length > config.max_input_tokens * 4
    ensures:
        Completion.created(prompt: prompt, primary_provider: config.primary_provider, status: failed)
}

-- #1486 review: incomplete credentials are refused before admission control: no anonymous provider request, no quota
-- slot, and a terminal failed completion. A timeout is also terminal failed rather than escaping as an exception.
rule MissingCredentialsFail {
    when: CompletionRequested(prompt)
    requires: not config.credentials_complete
    ensures:
        Completion.created(prompt: prompt, primary_provider: config.primary_provider, status: failed)
}

-- #1567: when the primary's quota is exhausted the fallback is asked first, provided it still has budget. The completion
-- keeps the configured primary label but its only attempt is the fallback actually called.
rule PrimaryQuotaExhaustedFallsBack {
    when: CompletionRequested(prompt)
    requires: config.credentials_complete
    requires: prompt.length <= config.max_input_tokens * 4
    requires: (QuotaUsage where provider = config.primary_provider).any(u => u.requests_this_minute >= u.max_per_minute or u.requests_today >= u.max_per_day)
    requires: (QuotaUsage where provider != config.primary_provider).all(u => u.requests_this_minute < u.max_per_minute and u.requests_today < u.max_per_day)
    ensures:
        let completion = Completion.created(
            prompt: prompt,
            primary_provider: config.primary_provider,
            status: pending
        )
        ProviderAttempt.created(completion: completion, provider: completion.fallback_provider)
        ProviderRequested(completion, completion.fallback_provider)
}

-- Both providers exhausted: the completion is silent, no provider is asked and no reply is sent. The notification is
-- driven by QuotaExhaustionNotifiedOnce, shared across the two providers.
rule BothQuotaExhaustedSilent {
    when: CompletionRequested(prompt)
    requires: config.credentials_complete
    requires: prompt.length <= config.max_input_tokens * 4
    requires: (QuotaUsage where provider = config.primary_provider).any(u => u.requests_this_minute >= u.max_per_minute or u.requests_today >= u.max_per_day)
    requires: (QuotaUsage where provider != config.primary_provider).any(u => u.requests_this_minute >= u.max_per_minute or u.requests_today >= u.max_per_day)
    ensures:
        Completion.created(prompt: prompt, primary_provider: config.primary_provider, status: silent)
}

-- #1567: every actual provider request counts against the provider that is called, including a fallback attempt. With
-- two providers the fallback is the other one, so its own counters and limits are the ones that increase.
rule CompletionConsumesQuota {
    when: ProviderRequested(completion, provider)
    ensures:
        let usage = QuotaUsage{provider: provider}
        usage.requests_this_minute = usage.requests_this_minute + 1
        usage.requests_today = usage.requests_today + 1
}

-- The notice is tied to the silent outcome (both providers exhausted), so a single episode produces one ops message
-- even when both budgets run out together. A failed notification does not mark the notice as sent: the next denial
-- tries again.
rule QuotaExhaustionNotifiedOnce {
    when: CompletionRequested(prompt)
    requires: config.credentials_complete
    requires: prompt.length <= config.max_input_tokens * 4
    requires: (QuotaUsage where provider = config.primary_provider).any(u => u.requests_this_minute >= u.max_per_minute or u.requests_today >= u.max_per_day)
    requires: (QuotaUsage where provider != config.primary_provider).any(u => u.requests_this_minute >= u.max_per_minute or u.requests_today >= u.max_per_day)
    requires: (QuotaNotice where sent = false).count > 0
    ensures:
        OperatorsNotified(reason: llm_quota_exhausted)
        for notice in QuotaNotice where notice.sent = false:
            notice.sent = true
}

-- As soon as any provider is admitted again a new exhaustion episode can begin, so the shared notice is reset.
rule QuotaNoticeResetsWhenQuotaReturns {
    when: CompletionRequested(prompt)
    requires: config.credentials_complete
    requires: prompt.length <= config.max_input_tokens * 4
    requires: (QuotaUsage).any(u => u.requests_this_minute < u.max_per_minute and u.requests_today < u.max_per_day)
    ensures:
        for notice in QuotaNotice where notice.sent = true:
            notice.sent = false
}

rule ProviderReturnsStructuredReply {
    when: ProviderResponded(completion, provider, result, reply?)
    requires: completion.status = pending
    requires: result = success
    requires: reply != null
    ensures:
        let attempt = ProviderAttempt{completion: completion, provider: provider}
        attempt.result = result
        completion.status = answered
        completion.reply = reply
}

rule MalformedProviderReplyFails {
    when: ProviderResponded(completion, provider, result, reply?)
    requires: completion.status = pending
    requires: result = malformed_json
    ensures:
        let attempt = ProviderAttempt{completion: completion, provider: provider}
        attempt.result = result
        completion.status = failed
}

-- A provider can answer 200 with a payload that parses but carries no reply object: it is not a structured reply.
rule SuccessWithoutReplyFails {
    when: ProviderResponded(completion, provider, result, reply?)
    requires: completion.status = pending
    requires: result = success
    requires: reply = null
    ensures:
        let attempt = ProviderAttempt{completion: completion, provider: provider}
        attempt.result = result
        completion.status = failed
}

rule NonRetryableProviderFailureFails {
    when: ProviderResponded(completion, provider, result, reply?)
    requires: completion.status = pending
    requires: result = rejected
    ensures:
        let attempt = ProviderAttempt{completion: completion, provider: provider}
        attempt.result = result
        completion.status = failed
}

-- A 429 (rate limit), a 5xx (server error) or a timeout from the primary provider is retried once against the other
-- provider, but only when the fallback has quota for that call. Other failures, and the same result from the fallback,
-- are not retried.
rule RetryableProviderFailureFallsBack {
    when: ProviderResponded(completion, provider, result, reply?)
    requires: completion.status = pending
    requires: result in {rate_limited, server_error, timeout}
    requires: provider = completion.primary_provider
    requires: not completion.attempts.any(a => a.provider = completion.fallback_provider)
    requires: (QuotaUsage where provider = completion.fallback_provider).all(u => u.requests_this_minute < u.max_per_minute and u.requests_today < u.max_per_day)
    ensures:
        let attempt = ProviderAttempt{completion: completion, provider: provider}
        attempt.result = result
        ProviderAttempt.created(completion: completion, provider: completion.fallback_provider)
        ProviderRequested(completion, completion.fallback_provider)
}

-- #1567: the primary failed retryably but the fallback's quota is exhausted, so no fallback request is made. The
-- completion fails recording only the attempt that actually reached a provider.
rule FallbackQuotaExhaustedAfterPrimaryFailure {
    when: ProviderResponded(completion, provider, result, reply?)
    requires: completion.status = pending
    requires: result in {rate_limited, server_error, timeout}
    requires: provider = completion.primary_provider
    requires: not completion.attempts.any(a => a.provider = completion.fallback_provider)
    requires: (QuotaUsage where provider = completion.fallback_provider).any(u => u.requests_this_minute >= u.max_per_minute or u.requests_today >= u.max_per_day)
    ensures:
        let attempt = ProviderAttempt{completion: completion, provider: provider}
        attempt.result = result
        completion.status = failed
}

-- A retryable result from the fallback ends the completion, whichever provider was asked first: after a primary failure
-- there are two attempts, but when the primary's quota was exhausted the fallback is the only attempt made.
rule CompletionFailsAfterFallbackExhausted {
    when: ProviderResponded(completion, provider, result, reply?)
    requires: completion.status = pending
    requires: result in {rate_limited, server_error, timeout}
    requires: provider = completion.fallback_provider
    requires: completion.attempts.any(a => a.provider = completion.fallback_provider)
    ensures:
        let attempt = ProviderAttempt{completion: completion, provider: provider}
        attempt.result = result
        completion.status = failed
}

-- #1487/#1488: the /llm switches are stored per chat and bot, and a toggle always refreshes the timestamp. The command
-- raises these events through the LlmSettings port; the storage behaviour is observable through that port.
rule LlmEnabledForChat {
    when: UserEnablesLlm(chat, bot)
    ensures:
        let setting = LlmChatSetting{chat: chat, bot: bot}
        setting.enabled = true
        setting.updated_at = now
}

rule LlmDisabledForChat {
    when: UserDisablesLlm(chat, bot)
    ensures:
        let setting = LlmChatSetting{chat: chat, bot: bot}
        setting.enabled = false
        setting.updated_at = now
}

rule LlmStatusIsOffWithoutSetting {
    when: LlmStatusRequested(chat, bot)
    requires: not exists LlmChatSetting{chat: chat, bot: bot}
    ensures: LlmStatusReported(enabled: false)
}

rule LlmStatusReportsStoredSetting {
    when: LlmStatusRequested(chat, bot)
    requires: exists LlmChatSetting{chat: chat, bot: bot}
    ensures: LlmStatusReported(enabled: (LlmChatSetting where chat = chat and bot = bot).any(s => s.enabled))
}

-- `forget` purges the remembered context of that chat and bot only: the switch, other chats and other bots are intact.
rule LlmForgetPurgesContext {
    when: UserForgetsLlmContext(chat, bot)
    ensures: not exists LlmContextMessage{chat: chat, bot: bot}
}

-- #1489: a message is offered to the context only while the chat's switch is on. The ignored event is the port saying
-- that nothing was stored: there is no context row for a chat that never enabled the LLM. The stored content is the
-- message text (or caption) with usernames redacted and line breaks escaped, prefixed with the stable anonymous sender
-- label: neither the raw sender identity nor a real username is persisted.
rule LlmContextRemembersEnabledChat {
    when: LlmContextMessageOffered(chat, bot, message)
    requires: exists LlmChatSetting{chat: chat, bot: bot, enabled: true}
    ensures:
        let labelled = anonymised_content(message, config.context_author_salt)
        LlmContextMessage.created(chat: chat, bot: bot, role: user, content: labelled, created_at: now)
}

rule LlmContextIgnoresDisabledChat {
    when: LlmContextMessageOffered(chat, bot, message)
    requires: not exists LlmChatSetting{chat: chat, bot: bot, enabled: true}
    ensures: LlmContextIgnored(chat: chat, bot: bot)
}

-- #1489: the cleanup cron deletes the expired messages of every chat and bot, without touching the newer ones. Its
-- scheduler fiber is owned by main and cancelled on shutdown, and a failing schedule is restarted with the job still
-- attached.
rule LlmContextCleanupDeletesExpired {
    when: LlmContextCleanupTick()
    ensures: not exists (LlmContextMessage where created_at < now - config.context_ttl)
}

-- #1488: /llm is a fixed command of every bot on every platform ("/llm" on Telegram and Discord, "!llm" on IRC). The
-- argument chooses one call of the port; a missing or unrecognised argument (`unknown` below) only gets the usage
-- reply, written with the command invocation of the platform.
rule LlmCommandOn {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = on
    ensures: UserEnablesLlm(chat, bot)
    ensures: LlmCommandResponded(chat: chat, text: "LLM replies enabled for this chat")
}

rule LlmCommandOff {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = off
    ensures: UserDisablesLlm(chat, bot)
    ensures: LlmCommandResponded(chat: chat, text: "LLM replies disabled for this chat")
}

rule LlmCommandStatus {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = status
    ensures: LlmStatusRequested(chat, bot)
}

rule LlmCommandForget {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = forget
    ensures: UserForgetsLlmContext(chat, bot)
    ensures: LlmCommandResponded(chat: chat, text: "LLM context forgotten for this chat")
}

rule LlmCommandUsage {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = unknown
    requires: chat.platform != irc
    ensures: LlmCommandResponded(chat: chat, text: "Usage: /llm on|off|status|forget")
}

rule LlmCommandIrcUsage {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = unknown
    requires: chat.platform = irc
    ensures: LlmCommandResponded(chat: chat, text: "Usage: !llm on|off|status|forget")
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant OneAttemptPerProvider {
    for c in Completions:
        for a in c.attempts:
            for b in c.attempts:
                a != b implies a.provider != b.provider
}

invariant ReplyOnlyWhenAnswered {
    for c in Completions:
        c.reply != null implies c.status = answered
}

-- A silent completion never reached a provider: no attempt, no reply, no fallback.
invariant SilentCompletionWasNotRequested {
    for c in Completions where c.status = silent:
        c.attempts.count = 0
        c.reply = null
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- Both boundaries are code-to-code: the caller of the client and the provider's HTTP endpoint.
actor LlmCaller {
    identified_by: LlmCaller where true
}

actor LlmProviderEndpoint {
    identified_by: LlmProviderEndpoint where true
}

-- The caller of the LlmSettings port: the /llm command of #1488 is one such caller, and the storage rules are also
-- reachable through the port itself.
actor LlmChatUser {
    identified_by: LlmChatUser where true
}

-- The cron scheduler of chatCore's CronBackgroundJobManager, registered from main: it is not a chat participant.
actor LlmCleanupScheduler {
    identified_by: LlmCleanupScheduler where true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LlmClientSurface {
    facing _: LlmCaller

    provides:
        CompletionRequested(prompt)

    contracts:
        fulfils LlmClient
}

surface LlmProviderBoundary {
    facing _: LlmProviderEndpoint

    provides:
        ProviderResponded(completion, provider, result, reply?)
}

-- The chatCore port, implemented by the doobie repositories of chatLlm (#1487).
surface LlmSettingsSurface {
    facing _: LlmChatUser

    provides:
        UserEnablesLlm(chat, bot)
        UserDisablesLlm(chat, bot)
        LlmStatusRequested(chat, bot)
        UserForgetsLlmContext(chat, bot)
}

-- The fixed command of #1488, available to every bot and every platform.
surface LlmCommandSurface {
    facing _: LlmChatUser

    provides:
        UserRunsLlmCommand(chat, bot, argument)
        LlmCommandResponded(chat, text)
}

-- The context service of #1489: the engine will offer messages to it with #1492.
surface LlmContextSurface {
    facing _: LlmChatUser

    provides:
        LlmContextMessageOffered(chat, bot, message)
        LlmContextIgnored(chat, bot)

    contracts:
        fulfils LlmContextWindow
}

-- The TTL cleanup is not a user action: the tick comes from the cron scheduler registered by main.
surface LlmCleanupSurface {
    facing _: LlmCleanupScheduler

    provides:
        LlmContextCleanupTick()
}

------------------------------------------------------------
-- Responder: prompt builder and output contract (#1491)
------------------------------------------------------------

-- The prompt is the versioned template (prompts/v1) filled with the persona, the catalogue entries of the candidate
-- replies, the chat context and the message. Context, catalogue and message are untrusted text: the template says they
-- are data, newlines and mentions are neutralised line by line, and a placeholder inside them is never expanded. The
-- length cap is one value: the prompt states it and the guard enforces it.
--
-- The candidates are the engine's matched replies that the catalogue describes, have at least one text trigger and
-- whose id is not shared with another candidate: only those can be reused, since only they have an unambiguous id.
rule ResponderAnswersWithText {
    when: ResponderAsked(msg, candidates, completion)
    requires: completion.status = answered
    requires: completion.reply.action = text
    requires: completion.reply.text_acceptable
    ensures: ResponderReplied(msg, completion.reply.text)
}

-- A reuse sends the chosen candidate's own reply, unchanged, through the normal reply path.
rule ResponderReusesCandidate {
    when: ResponderAsked(msg, candidates, completion)
    requires: completion.status = answered
    requires: completion.reply.action = reuse
    requires: candidates.any(c => c.catalogue_id = completion.reply.reply_id)
    let chosen = candidates.where(c => c.catalogue_id = completion.reply.reply_id).first
    ensures: ResponderReplied(msg, chosen.reply)
}

-- Anything else is silent: the silent action, a reuse of an id that is not an offered candidate, a failed completion,
-- a client error, or a text that is not acceptable. A text over the cap (500 characters, counted in code points) is
-- truncated, not dropped. A provider reply without a valid action, or with a non-string text or reply id, is already
-- malformed at the provider boundary. The reply language is the one the persona states (Italian when it states none); this is required by the prompt only, not checked.
rule ResponderStaysSilent {
    when: ResponderAsked(msg, candidates, completion)
    requires: completion.status != answered
        or completion.reply.action = silent
        or (completion.reply.action = text and not completion.reply.text_acceptable)
        or (completion.reply.action = reuse and not candidates.any(c => c.catalogue_id = completion.reply.reply_id))
    ensures: ResponderSilent(msg)
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Routing in BotEngine (#1492): the order between reply bundles and the LLM, and the directed-at-bot gate."
open question "Privacy note (#1483, #1498): the Gemini free tier may not be offered to minors or EEA/UK/CH users. #1485 only makes the provider switch configurable; it does not authorise a free-tier deployment."
