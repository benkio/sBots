-- allium: 3
-- llm.allium: the LLM replies of the bots (epic #1499). The LLM replies are being rebuilt on LLM4s: only what the code
-- does today is specified, which is the /llm switch and a single LLM entry point of the engine that does nothing.
-- Code: modules/chatCore (llm: the LlmSettings, LlmResponder and LlmWiring ports; patterns/LlmCommands; the LlmEngine
-- port and BotEngine), modules/chatLlm (LlmEngine, the responder built from the startup clients, LlmLoader, ChatLlm and
-- the doobie DBLlmSettings) and modules/main (startup wiring). Tables: V13 in botDB.
--
-- The persona files (<botid>_persona.md) and the prompt template (prompts/system.md) stay in the repository as data
-- only: nothing reads them now.

use "./sbots.allium" as core

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- #1487: one setting per (chat, bot); the chat already carries the platform. A chat with no row is off, so enabling is
-- explicit (#1488). The updated timestamp is epoch seconds and changes on both enable and disable. The tables are V13
-- in botDB: the issue asked for V11, but V11 and V12 are already applied in production and Flyway does not allow
-- out-of-order migrations.
entity LlmChatSetting {
    chat: core/Chat
    bot: core/Bot
    enabled: Boolean = false
    updated_at: Timestamp
}

-- #1487: the context rows of a chat. The table exists but nothing writes to it now; `forget` still deletes the rows of
-- the chat and bot.
entity LlmContextMessage {
    chat: core/Chat
    bot: core/Bot
    role: user | assistant
    content: String
    created_at: Timestamp
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- #1488: /llm is a fixed command of every bot on every platform ("/llm" on Telegram and Discord, "!llm" on IRC). The
-- argument is trimmed and case-insensitive; a missing or unrecognised argument (`unknown` below) only gets the usage
-- reply, written with the command invocation of the platform. The switch is per chat and per bot, and a toggle always
-- refreshes the timestamp.
rule LlmCommandOn {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = on
    ensures:
        let setting = LlmChatSetting{chat: chat, bot: bot}
        setting.enabled = true
        setting.updated_at = now
        LlmCommandResponded(chat: chat, text: "LLM replies enabled for this chat")
}

rule LlmCommandOff {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = off
    ensures:
        let setting = LlmChatSetting{chat: chat, bot: bot}
        setting.enabled = false
        setting.updated_at = now
        LlmCommandResponded(chat: chat, text: "LLM replies disabled for this chat")
}

rule LlmCommandStatusEnabled {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = status
    requires: exists LlmChatSetting{chat: chat, bot: bot, enabled: true}
    ensures: LlmCommandResponded(chat: chat, text: "LLM replies are enabled for this chat")
}

-- A chat with no row reports disabled.
rule LlmCommandStatusDisabled {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = status
    requires: not exists LlmChatSetting{chat: chat, bot: bot, enabled: true}
    ensures: LlmCommandResponded(chat: chat, text: "LLM replies are disabled for this chat")
}

-- `forget` deletes the context rows of that chat and bot only: the switch, other chats and other bots are intact.
rule LlmCommandForget {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = forget
    ensures:
        not exists LlmContextMessage{chat: chat, bot: bot}
        LlmCommandResponded(chat: chat, text: "LLM context forgotten for this chat")
}

rule LlmCommandUsage {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = unknown
    requires: chat.platform != irc
    ensures: LlmCommandResponded(chat: chat, text: "Usage: /llm on|off|status|forget")
}

rule LlmCommandIrcUsage {
    when: UserRunsLlmCommand(chat, bot, argument)
    requires: argument = unknown
    requires: chat.platform = irc
    ensures: LlmCommandResponded(chat: chat, text: "Usage: !llm on|off|status|forget")
}

-- The engine has a single LLM entry point. It runs after, and outside, the request processing timeout, for every
-- handled request (any message type, never a duplicate, a timed-out or a failed one). It does nothing: the bot never
-- answers with an LLM, whatever the /llm switch says.
rule LlmEntryPointDoesNothing {
    when: LlmEntryPointReached(request)
    requires: request.outcome = handled
    ensures: LlmNotAsked(request)
}

-- A failing LLM never fails the handling of the request: the error is logged and the request counts as unanswered by
-- the LLM, so the outcome of the reactive part stands.
rule LlmEntryPointFailureIsSwallowed {
    when: LlmEntryPointFailed(request)
    ensures:
        LlmFailureLogged(request)
        LlmOutcomeUnchanged(request)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- The user running /llm in a chat.
actor LlmChatUser {
    identified_by: LlmChatUser where true
}

-- The engine itself, reaching its LLM entry point after a request: it is not a chat participant.
actor LlmEngine {
    identified_by: LlmEngine where true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The fixed command of #1488, available to every bot and every platform.
surface LlmCommandSurface {
    facing _: LlmChatUser

    provides:
        UserRunsLlmCommand(chat, bot, argument)
        LlmCommandResponded(chat, text)
}

surface LlmEntryPointSurface {
    facing _: LlmEngine

    provides:
        LlmEntryPointReached(request)
        LlmEntryPointFailed(request)
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "The LLM replies are being rebuilt on LLM4s: which messages get an answer, the prompt, persona and context window, providers, quotas, output guard and observability are unspecified until that work lands."
open question "Privacy note (#1483, #1498): the Gemini free tier may not be offered to minors or EEA/UK/CH users. Revisit for the provider chosen in the LLM4s rebuild."
