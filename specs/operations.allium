-- allium: 3
-- operations.allium: app wiring, runtimes, health and stats (modules/main), plus the operator-invoked file generators.

use "./sbots.allium" as core

external entity HealthCheck {
    status: up | late | down
}

-- a call to the health-check URL, for each signal sent
external entity HealthPing {
    app: Application
    kind: start | heartbeat | fail
    failed: Boolean
}

enum EndKind { crashed | completed | cancelled }

entity Application {
    mode: webhook | polling
    status: running | stopped | crashed
    started_at: Timestamp
    next_heartbeat_tick: Timestamp
    last_system_stats: Timestamp
    end: EndKind?                -- how the application ended, set once
    crash_reason: String?        -- set when end = crashed

    transitions status {
        running -> stopped
        running -> crashed
        terminal: stopped, crashed
    }
}

-- one runtime per platform that at least one bot runs on; a platform without bots has no runtime
entity PlatformRuntime {
    platform: core/Platform
}

entity BotOnPlatform {
    bot: core/Bot
    platform: core/Platform
    status: active | lost
    failure: String?             -- set when the bot fails on this platform

    transitions status {
        active -> lost
        terminal: lost
    }
}

config {
    heartbeat_restart_delay: Duration = 30.seconds
    system_stats_every: Duration = 1.minute
    heartbeat_every: Duration = 10.minutes
}

-- operational tuning, not product decisions: the heartbeat cadence comes from `main.healthcheck-ping.cron` (10 minutes
-- by default, no environment override) and the stats cadence is the hardcoded `StatsLogger.start` default (1 minute).
-- `heartbeat_every` approximates the cron for this spec.

-- Telegram (webhook or polling), Discord and IRC have runtimes; Slack is in the Platform enum but has none.
surface OperatorShell {
    facing _: core/Operator

    exposes:
        HealthCheck.status

    provides:
        OperatorStartsApp(mode, bots)
        OperatorRunsGenerators()
}

rule AppStarts {
    when: OperatorStartsApp(mode, bots)
    requires: bots.all(b => b.platforms.all(p => p != slack))   -- generally: every platform of a bot has a runtime
    ensures:
        for b in bots:
            for p in b.platforms:
                BotOnPlatform.created(bot: b, platform: p, status: active)
    ensures:
        for p in bots.flatmap(b => b.platforms):
            PlatformRuntime.created(platform: p)
    ensures: Application.created(mode: mode, status: running, started_at: now, next_heartbeat_tick: now + config.heartbeat_every, last_system_stats: now)
    ensures: HealthSignalSent(kind: start)
}

-- production passes the whole bot registry to the webhook main; the polling main optionally accepts bot ids or names to
-- run a subset, and aborts on an unknown name before the app starts. Both paths are already modelled by `bots`.

rule AppRefusesBotWithoutRuntime {
    when: OperatorStartsApp(mode, bots)
    requires: bots.any(b => b.platforms.any(p => p = slack))
    -- no Application exists on this path; a refused start only sends the fail signal
    ensures: HealthSignalSent(kind: fail)
}

-- a bot that fails on a platform (Telegram, Discord or IRC) stops there only: the other bots keep running, the failure is
-- logged and the health check fails
rule BotStopsOnConnectionPlatform {
    when: entry: BotOnPlatform.failure != null
    requires: entry.status = active
    ensures: entry.status = lost
    ensures: HealthSignalSent(kind: fail)
}

-- intentional: there is no per-bot supervisor. A lost bot stays lost until the app restarts; the fail signal only alerts
-- operators, and the process supervisor respawns the app only when the whole process exits. Connection losses handled by
-- the platform libraries (JDA, Kitteh) are not bot failures.

-- the heartbeat follows a wall-clock cron (every 10 minutes), not the start time; a failed ping sleeps the restart delay
-- and then waits for the next cron tick

rule HeartbeatTick {
    when: app: Application.next_heartbeat_tick <= now
    requires: app.status = running
    ensures: HealthSignalSent(kind: heartbeat)
    ensures: app.next_heartbeat_tick = now + config.heartbeat_every
}

rule HeartbeatRecovers {
    when: ping: HealthPing.failed = true
    requires: ping.kind = heartbeat and ping.app.status = running
    -- failed = the ping raised an error, timed out (10 seconds) or was not accepted (non-2xx); it resumes after the delay.
    -- a refused start or fail signal is only a logged warning
    ensures: HeartbeatResumesAt(at: now + config.heartbeat_restart_delay)
}

rule AppCrashes {
    when: app: Application.end != null
    requires: app.end = crashed
    requires: app.status = running
    -- the reason is always logged; an operator-configured crash history also records time and stack trace
    ensures: CrashLogged(reason: app.crash_reason)
    ensures: app.status = crashed
    ensures: HealthSignalSent(kind: fail)
}

rule AppStops {
    when: app: Application.end != null
    requires: app.end = completed or app.end = cancelled
    requires: app.status = running
    ensures: app.status = stopped
}

-- the Grafana dashboard depends on the stats keys, they must stay stable
rule UsageStatsLine {
    -- one line for every outcome (trigger-matched, duplicate, timeout, failed, llm-replied)
    when: request: core/Request.outcome != null
    ensures: StatsLineWritten(kind: message, bot: request.bot)
}

rule SystemStatsLine {
    when: app: Application.last_system_stats + config.system_stats_every <= now
    requires: app.status = running
    -- heap, uptime, db size (-1 when the DB file is missing) and the host values (-1 when unreadable): total, available
    -- and free memory, the process RSS, the three load averages and CPU usage;
    -- the keys are dashboard-dependent, so new ones are appended; a failed collection is only a warning
    ensures: StatsLineWritten(kind: system)
    ensures: app.last_system_stats = now
}

-- ops notifications go to the Telegram ops chat for Telegram bots and only to the log for Discord and IRC bots (intended)
-- Slack is kept in the Platform enum as planned: a bot configured for it makes startup fail (intended)
-- the crash history is optional operator-configured infrastructure: with no history path configured the app logs and
-- signals the crash but creates no file in its launch directory

-- Telegram startup: probes (db, Telegram, Dropbox, Mega) and, after a deploy, a test media file to the ops chat.
-- A failed check never blocks the start.
rule StartupCheckReports {
    when: entry: BotOnPlatform.created
    requires: entry.platform = telegram
    ensures: core/OperatorsNotified(bot: entry.bot, reason: started_with_report)
}

-- The IRC send delay, ready timeout and shutdown timeout are infrastructure tuning, not specified.
-- The generators are an explicit operator action (sbt fix) run after bot data changes: for each bot they write the
-- triggers list, the instructions and the calendar files. Read-only verification (sbt verify / CI) checks the
-- checked-in files instead, so it never triggers this rule.
rule GeneratorsWriteBotFiles {
    when: OperatorRunsGenerators()
    ensures:
        for b in core/Bots:
            BotFilesGenerated(bot: b)
}
-- secrets (keystore password, health-check URL) are redacted from the configuration logged at startup

-- all earlier open questions are resolved above: the intervals are operational tuning, bot selection is already
-- modelled by the `bots` argument, and the absence of a per-bot supervisor is intentional.
