-- allium: 3
-- platforms.allium: the chat adapters (modules/chatTelegramAdapter, chatDiscordAdapter, chatIrcAdapter):
-- how platform events become Messages and how Replies are delivered. Excludes transport libraries and wiring.

use "./sbots.allium" as core
use "./engine-extras.allium" as extras

actor ChatUser {
    identified_by: ChatUser where true
}

-- what a platform supports, used by the engine to adapt replies (text split, markdown to plain, media to link, ...)
value PlatformCapabilities {
    command_prefix: String
    max_text_length: Integer
    native_markdown: Boolean
    supports_delete: Boolean
    supports_edit: Boolean
    supported_media: Set<String>
    supports_buttons: Boolean
    accepts_file_ids: Boolean
    supplies_sender_id: Boolean
}

-- telegram: "/", 4096, markdown yes, delete yes, edit yes, buttons yes, sender id yes, file ids yes, every media kind
-- discord:  "/", 2000, markdown yes, delete yes, edit yes, buttons yes, sender id yes, file ids no,  audio gif photo video document markdown_file
-- irc:      "!", 400,  markdown no,  delete no,  edit no,  buttons no,  sender id no,  file ids no,  markdown_file only

external entity PlatformAdapter {
    platform: core/Platform
    capabilities: PlatformCapabilities
}

entity SentMessage {
    chat: core/Chat
    time_to_live: Duration?
    sent_at: Timestamp
    deleted: Boolean
}

-- Discord shows a paged list with message components (Telegram gives every item button its own row, which needs 6 rows;
-- Discord allows only 5)
entity DiscordButtonList {
    message: SentMessage
    requested_by: String             -- the Discord user who asked for the list, the only one who can use its buttons
    page: Integer
    item_count: Integer
    items_on_page: Integer           -- 1 to paged_list_page_size: the buttons "1" to "n" of row 1
    has_prev: page > 0               -- previous is enabled
    has_next: (page + 1) * extras/config.paged_list_page_size < item_count
}

entity InlineKeyboard {
    message: SentMessage
    page: Integer
    item_count: Integer
    has_prev: page > 0                                         -- the previous page button is offered only then
    has_next: (page + 1) * config.page_size < item_count       -- the next page button is offered only then
}

-- the adapter reports these as they happen
external entity DiscordConnection {
    bot: core/Bot
}

external entity MediaSend {
    chat: core/Chat
    bot: core/Bot
    failed: Boolean
}

external entity CallbackPress {
    keyboard: InlineKeyboard
    kind: previous_page | next_page | media | show
}

external entity IrcConnection {
    bot: core/Bot
    lost: Boolean
}

external entity TelegramUpdate {
    bot: core/Bot
    kind: message | callback_query
    chat: core/Chat
    bot_added: Boolean
    member_count: Integer?    -- of the chat, read when the bot is added
}

external entity DiscordEvent {
    bot: core/Bot
    kind: message | slash_command
    channel: String
    is_direct: Boolean
    author_is_bot: Boolean
    text: String
    command_name: String?
    arguments: String?
}

external entity IrcEvent {
    bot: core/Bot
    sender: String
    channel: String?
    text: String
}

config {
    page_size: Integer = 5
    notifier_dedup_window: Duration = 5.minutes
    discord_max_upload_bytes: Integer = 10485760
    discord_max_slash_commands: Integer = 100
    irc_max_lines_per_reply: Integer = 20
    irc_rate_limit_messages: Integer = 5
    irc_rate_limit_window: Duration = 10.seconds
    irc_reconnect_base_delay: Duration = 2.seconds
    irc_reconnect_max_delay: Duration = 60.seconds
    irc_message_delay: Duration = 1200.milliseconds
}

------------------------------------------------------------
-- Inbound
------------------------------------------------------------

-- The joined members of a Telegram message are split by the bot's own Telegram id, which never changes and is the
-- numeric prefix of its Telegram token: the bot goes to bot_added, the others stay in new_members.
rule TelegramMessageBecomesMessage {
    when: update: TelegramUpdate.created
    requires: update.kind = message
    ensures: core/BotReceivesMessage(message: update, bot: update.bot)
}

rule TelegramBotAddedRaisesJoin {
    when: TelegramUpdateReceived(update, bot)
    requires: update.kind = message
    requires: update.bot_added
    requires: update.member_count != null
    ensures: extras/BotJoinsChat(chat: update.chat, bot: bot, member_count: update.member_count)
}

-- Discord: the bot is invited to a server. The timeouts are per channel, so the join counts as a join of every text
-- channel the bot can write to, each with the member count of the server. Channels created later get no timeout.
-- No welcome reply is involved.
external entity DiscordGuildJoin {
    channels: Set<core/Chat>
    member_count: Integer
}

rule DiscordGuildJoinRaisesJoin {
    when: DiscordGuildJoinReceived(join, bot)
    ensures: for channel in join.channels:
        extras/BotJoinsChat(chat: channel, bot: bot, member_count: join.member_count)
}

rule DiscordMessageBecomesMessage {
    when: e: DiscordEvent.created
    requires: e.kind = message
    requires: not e.author_is_bot
    requires: e.text.trim != ""
    -- the chat is the channel: private for a direct message, group for the channel of a server
    ensures: core/BotReceivesMessage(message: e, bot: e.bot, chat: DiscordChat(e.channel, e.is_direct))
}

rule DiscordSlashCommandBecomesCommandMessage {
    when: e: DiscordEvent.created
    requires: e.kind = slash_command
    requires: not e.author_is_bot
    requires: e.command_name != null
    -- the interaction is acknowledged invisibly and the acknowledgement deleted at once, replies are plain channel messages;
    -- the message has no id: the interaction is not a message to reply to
    -- the message text is "/" + command name + optional trimmed arguments, in the command syntax of the platform
    ensures: core/BotReceivesMessage(message: e, bot: e.bot, text: SlashCommandText(e.command_name, e.arguments),
                                     chat: DiscordChat(e.channel, e.is_direct))
}

-- IRC limitation (intended): no message ids and no message times, so dedup and the older-message filter never apply
rule IrcLineBecomesMessage {
    when: e: IrcEvent.created
    -- colour and format codes are stripped; the bot's own echo, empty lines and senders over the rate limit are ignored
    -- IRC has no message ids (no deduplication) and no message times (sent_at is the receive time)
    -- the code compares with the nick the connection actually has, which a server can change from bot.nick (intended)
    requires: e.sender.lower != e.bot.nick.lower
    -- the empty check is made after the colour and format codes are stripped
    requires: e.text.trim != ""
    requires: not IrcSenderOverLimit(sender: e.sender)
    -- the chat is the channel, or the sender for a private message (channel = null), compared in lower case
    ensures: core/BotReceivesMessage(message: e, bot: e.bot, chat: IrcChat(e.channel ?? e.sender, e.channel = null))
}

-- fixed window per sender, over the limit the line gets no reply (an info log line is written)
rule IrcSenderOverRateLimitIgnored {
    when: e: IrcEvent.created
    requires: IrcSenderOverLimit(sender: e.sender)
    ensures: IrcLineDropped(sender: e.sender)
}

rule DiscordRegistersSlashCommands {
    when: c: DiscordConnection.created
    -- one slash command per command reply that has English instructions, lowercase 1-32 chars [a-z0-9_-],
    -- (any Unicode letter or digit is accepted), the description is cut to 100 characters with an ellipsis,
    -- deduplicated, first config.discord_max_slash_commands kept, replacing the bot's command set;
    -- a registration failure is logged and the bot keeps running
    ensures: SlashCommandsRegistered(bot: c.bot)
}

------------------------------------------------------------
-- Outbound
------------------------------------------------------------

rule TelegramSendsText {
    when: core/Reply.sent(chat, reply)
    requires: reply.delivery = text
    -- quotes the triggering message when asked and it has an id
    ensures: SentMessage.created(chat: chat, time_to_live: reply.time_to_live, sent_at: now, deleted: false)
}

rule SentMessageExpires {
    when: m: SentMessage.sent_at + m.time_to_live <= now
    requires: m.time_to_live != null
    requires: not m.deleted
    ensures: m.deleted = true
}

-- sources are tried in order (stored platform file ids first, then the downloadable file); the id that worked is cached
-- a reply value the platform cannot send (a Telegram sticker on Discord, other unsupported kinds on Telegram) sends
-- nothing and only logs a warning (intended)
-- while a file is sent the chat shows the action matching its kind (upload_voice, upload_photo, upload_video,
-- upload_document for gifs and documents, choose_sticker for stickers)
rule SendMediaFile {
    when: core/Reply.sent(chat, reply)
    requires: reply.delivery = media_file
    ensures: MediaDelivered(chat: chat)
}

rule MediaSendFailureNotified {
    when: send: MediaSend.failed = true
    -- the other replies of the same request are unaffected; missing files and missing chat rights are only logged
    ensures: core/OperatorsNotified(bot: send.bot, reason: media_error)
}

rule SendPagedListAsKeyboard {
    when: core/Reply.sent(chat, reply)
    requires: reply.delivery = paged_list
    requires: chat.platform = telegram
    ensures: InlineKeyboard.created(message: SentMessage.created(chat: chat, time_to_live: null, sent_at: now, deleted: false),
                                    page: 0, item_count: reply.item_count)
}

-- Telegram only (Discord and Slack buttons, IRC and Twitch text commands follow on the same navigation), handled outside
-- the engine on purpose: a press answers the bot's own message, so no dedup, age, timeout or forward filter applies and
-- there is no post computation. The press is decoded into the platform-neutral extras/PagedListAction and the replies
-- come from extras/PagedListNavigation; only the keyboard of the message is Telegram specific.
rule CallbackIsPagedListAction {
    when: CallbackPressed(keyboard, kind)
    ensures: extras/PagedListActionRequested(
        chat: keyboard.message.chat,
        bot: keyboard.message.bot,
        action: DecodedAction(keyboard, kind)
    )
}

rule CallbackPagesKeyboard {
    when: press: CallbackPress.created
    -- the buttons are offered only when has_prev / has_next
    requires: (press.kind = previous_page and press.keyboard.has_prev) or (press.kind = next_page and press.keyboard.has_next)
    ensures: press.keyboard.page = if press.kind = next_page: press.keyboard.page + 1 else: press.keyboard.page - 1
}

-- a press on a stale button is rejected: the message keyboard, and so its page, is left as it is. In particular a
-- stale next past the last page no longer shows an empty page.
rule CallbackOnStaleButton {
    when: press: CallbackPress.created
    requires: (press.kind = previous_page and not press.keyboard.has_prev) or (press.kind = next_page and not press.keyboard.has_next)
    ensures: CallbackPressRejected(press: press)
}

rule CallbackDeliversMedia {
    when: press: CallbackPress.created
    requires: press.kind = media
    ensures: press.keyboard.message.deleted = true
}

rule CallbackDeliversShow {
    when: press: CallbackPress.created
    requires: press.kind = show
    ensures: press.keyboard.message.deleted = true
}

-- Discord: the message lists the items of the page as numbered text, cut to max_text_length; the items Discord cannot
-- send (Telegram stickers) are left out of the text and the buttons, with contiguous numbering. Row 1 has one button
-- per item of the page that can be picked (a media file, a show or a trigger candidate), labelled with the number of
-- the item in the text, row 2 has previous and next (disabled at the first and at the last page), only when there is
-- more than one page. The lists are
-- remembered in memory by the id of their message: they expire and a restart forgets them (the buttons then say the list
-- is gone). The id of every button is the one of the platform-neutral PagedListAction (at most 100 characters, the label at
-- most 80).
rule SendPagedListAsDiscordButtons {
    when: core/Reply.sent(chat, reply)
    requires: reply.delivery = paged_list
    requires: chat.platform = discord
    ensures: DiscordButtonList.created(
        message: SentMessage.created(chat: chat, time_to_live: null, sent_at: now, deleted: false),
        requested_by: reply.requested_by,      -- the author of the message that asked for the list
        page: 0,
        item_count: reply.item_count,
        items_on_page: min(reply.item_count, extras/config.paged_list_page_size)
    )
}

-- a press is acknowledged within the 3 seconds Discord allows (deferred edit) before anything else, then decoded into the
-- neutral action: previous and next edit the message in place, a pick sends the item as a new message.
rule DiscordButtonIsPagedListAction {
    when: DiscordButtonPressed(list, id, user)
    requires: user = list.requested_by
    requires: PagedListIdDecodes(id)
    ensures: DiscordButtonAcknowledged(list: list)
    ensures: extras/PagedListActionRequested(
        chat: list.message.chat,
        bot: list.message.bot,
        action: DecodedAction(id)
    )
}

rule DiscordButtonPagesList {
    when: DiscordButtonPressed(list, id, user)
    requires: user = list.requested_by
    requires: PagedListIdDecodes(id)
    requires: DecodedAction(id).kind = previous_page or DecodedAction(id).kind = next_page
    ensures: list.page = if DecodedAction(id).kind = next_page: list.page + 1 else: max(list.page - 1, 0)
}

-- picking an item deletes the list message (as on Telegram) and sends the item as a new message
rule DiscordButtonPickDeletesList {
    when: DiscordButtonPressed(list, id, user)
    requires: user = list.requested_by
    requires: PagedListIdDecodes(id)
    requires: DecodedAction(id).kind = pick_media or DecodedAction(id).kind = pick_show
    ensures: list.message.deleted = true
}

-- anyone else pressing a button gets a clear text only they see (an ephemeral answer): the list does not change and no
-- action is requested
rule DiscordButtonOfAnotherUser {
    when: DiscordButtonPressed(list, id, user)
    requires: user != list.requested_by
    ensures: DiscordButtonRejected(list: list)
}

-- a button of a list that is expired or unknown (a bot restart forgets nothing the id needs, but the message may be gone or
-- the id may not decode) answers with a clear text, visible only to who pressed, and changes nothing
rule DiscordButtonOfUnknownList {
    when: DiscordButtonPressed(list, id, user)
    requires: user = list.requested_by
    requires: not PagedListIdDecodes(id)
    ensures: DiscordButtonRejected(list: list)
}

-- Discord: text and markdown sent as messages, quoting the triggering message, deleted after their time to live (empty sends nothing); media urls tried in order, a file over the upload
-- limit is sent as its link; markdown files are sent in chunks of 2000 characters; other reply kinds send nothing.
-- IRC: all replies of a request form one logical reply, markdown becomes plain text, text is split on line breaks and each
-- line cut at 400 characters and bytes, capped at irc_max_lines_per_reply ("(K more lines not shown)"), paced by the send delay.
-- IRC: the text of a paged list says how to move it: the text commands of the engine's text mode, with the prefix
-- of the platform (`!next`/`!prev`, and `!pick 1-5` with the numbers of the items of the page). The lists are
-- remembered by the engine: the commands act on the last paged list shown in each chat
-- (extras/PagedListTextStoreEntry).
rule IrcSendsReply {
    when: core/Reply.sent(chat, reply)
    ensures: IrcLinesSent(chat: chat)
}

rule IrcReconnects {
    when: c: IrcConnection.lost = true
    -- the delay doubles on each failed attempt up to the maximum, the attempt count resets on every successful registration,
    -- channels are joined again on registration
    ensures: ReconnectScheduled(bot: c.bot)
}

-- inline keyboards exist only where the platform supports buttons
invariant KeyboardsOnlyWhereSupported {
    for k in InlineKeyboards:
        for a in PlatformAdapters:
            a.platform = k.message.chat.platform implies a.capabilities.supports_buttons
}

-- the text commands of the text mode of a platform without buttons are not commands of the platforms with buttons
invariant TextCommandsOnlyWithoutButtons {
    for e in extras/PagedListTextStoreEntry:
        for a in PlatformAdapters:
            a.platform = e.chat.platform implies not a.capabilities.supports_buttons
}

-- Guided /subscribe (extras/SubscriptionFlowActionRequested, extras/GuidedSubscriptionFlowAdapter): the engine owns
-- the draft (extras/SubscriptionDraft), so a button carries only the step action. The flow needs a requester to own
-- the draft and edit support to update the prompt; it therefore exists on Telegram and Discord only. On a platform
-- with no sender id or no edit support (IRC) bare /subscribe keeps the one-shot usage error and no flow starts.
-- A prompt press records the prompt's owner and the user who pressed; only the owner's press becomes a neutral action.
-- A press by anyone else gets a private answer (a callback answer or an ephemeral message) and changes nothing.
-- At the schedule step a plain message from the owner maps to an enter_cron action with that text (the typed custom
-- cron); at the target step a plain message maps to enter_target, and a random button maps to enter_target with empty
-- text. Plain messages at other steps are not flow actions. A command is never a plain message: bare /subscribe always
-- starts or restarts the flow, even while another step is active.
-- Each step edits the same prompt message in place; errors and the final subscription result are new replies.
external entity SubscriptionFlowPromptPress {
    chat: core/Chat
    bot: core/Bot
    action: extras/SubscriptionFlowAction
    prompt_owner: String
    user: String
}

rule SubscriptionFlowPromptPressIsAction {
    when: press: SubscriptionFlowPromptPress.created
    requires: press.user = press.prompt_owner
    ensures: extras/SubscriptionFlowActionRequested(chat: press.chat, bot: press.bot, action: press.action, requester: press.user)
}

rule SubscriptionFlowPromptPressOfAnotherUser {
    when: press: SubscriptionFlowPromptPress.created
    requires: press.user != press.prompt_owner
    ensures: SubscriptionFlowPromptPressRejected(press: press)   -- private answer only, no action
}

invariant GuidedFlowOnlyWhereRequesterAndEdit {
    for p in SubscriptionFlowPromptPress:
        for a in PlatformAdapters:
            a.platform = p.chat.platform implies a.capabilities.supplies_sender_id and a.capabilities.supports_edit
}

-- intended: picking a Media or Show is terminal, so the keyboard message is deleted after the new message; paging
-- edits the keyboard in place (CallbackPagesKeyboard, DiscordButtonPagesList).
-- known defect: a pick deletes the list even when sending the item fails, because the senders log and swallow that
-- failure, so a transient error loses the list. Keeping it on failure would be a product decision.
-- an unparsable Telegram callback is rejected like any other bad id (extras/PagedListRejectsBadId): it is answered with
-- an error and never treated as a media file named by the raw data.
-- intended: only media send failures reach operators; text, rich-text, keyboard and list failures are logged only, to
-- avoid spam from user input and missing rights (MediaSendFailureNotified).
-- intended: quoting the triggering message is a per-reply, best-effort platform affordance (core/Reply.reply_to_message):
-- a no-op without a message id and absent on IRC. It is presentation, not a domain requirement.
-- intended: the Discord message-content intent is enabled by default (main.discord.message-content); with it off plain
-- messages carry no text and only slash commands reach the bot. Slash-command registration is independent of it.
-- intended: the IRC rate limit is a fixed window, so up to 2N lines can cross a window edge; over-limit lines are
-- silently dropped with an info log. The 400-character and 20-line caps follow the IRC 512-byte line and flood limits,
-- so they stay platform-specific; promoting them to platform-agnostic rules would be a product decision.
