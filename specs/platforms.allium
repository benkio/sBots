-- allium: 3
-- platforms.allium: the chat adapters (modules/chatTelegramAdapter, chatDiscordAdapter, chatIrcAdapter):
-- how platform events become Messages and how Replies are delivered. Excludes transport libraries and wiring.

use "./sbots.allium" as core
use "./engine-extras.allium" as extras

actor ChatUser {
    identified_by: ChatUser where true
}

-- what a platform supports, used by the engine to adapt replies (text split, markdown to plain, media to link, ...)
value PlatformCapabilities {
    command_prefix: String
    max_text_length: Integer
    native_markdown: Boolean
    supports_delete: Boolean
    supports_edit: Boolean
    supported_media: Set<String>
    supports_buttons: Boolean
    accepts_file_ids: Boolean
}

-- telegram: "/", 4096, markdown yes, delete yes, buttons yes, file ids yes, every media kind
-- discord:  "/", 2000, markdown yes, delete yes, buttons no,  file ids no,  audio gif photo video document markdown_file
-- irc:      "!", 400,  markdown no,  delete no,  buttons no,  file ids no,  markdown_file only

external entity PlatformAdapter {
    platform: core/Platform
    capabilities: PlatformCapabilities
}

entity SentMessage {
    chat: core/Chat
    time_to_live: Duration?
    sent_at: Timestamp
    deleted: Boolean
}

entity InlineKeyboard {
    message: SentMessage
    page: Integer
    item_count: Integer
    has_prev: page > 0                                         -- the previous page button is offered only then
    has_next: (page + 1) * config.page_size < item_count       -- the next page button is offered only then
}

-- the adapter reports these as they happen
external entity DiscordConnection {
    bot: core/Bot
}

external entity MediaSend {
    chat: core/Chat
    bot: core/Bot
    failed: Boolean
}

external entity CallbackPress {
    keyboard: InlineKeyboard
    kind: previous_page | next_page | media | show
}

external entity IrcConnection {
    bot: core/Bot
    lost: Boolean
}

external entity TelegramUpdate {
    bot: core/Bot
    kind: message | callback_query
    chat: core/Chat
    bot_added: Boolean
    member_count: Integer?    -- of the chat, read when the bot is added
}

external entity DiscordEvent {
    bot: core/Bot
    kind: message | slash_command
    channel: String
    is_direct: Boolean
    author_is_bot: Boolean
    text: String
    command_name: String?
    arguments: String?
}

external entity IrcEvent {
    bot: core/Bot
    sender: String
    channel: String?
    text: String
}

config {
    page_size: Integer = 5
    notifier_dedup_window: Duration = 5.minutes
    discord_max_upload_bytes: Integer = 10485760
    discord_max_slash_commands: Integer = 100
    irc_max_lines_per_reply: Integer = 20
    irc_rate_limit_messages: Integer = 5
    irc_rate_limit_window: Duration = 10.seconds
    irc_reconnect_base_delay: Duration = 2.seconds
    irc_reconnect_max_delay: Duration = 60.seconds
    irc_message_delay: Duration = 1200.milliseconds
}

------------------------------------------------------------
-- Inbound
------------------------------------------------------------

-- The joined members of a Telegram message are split by the bot's own Telegram id, which never changes and is the
-- numeric prefix of its Telegram token: the bot goes to bot_added, the others stay in new_members.
rule TelegramMessageBecomesMessage {
    when: update: TelegramUpdate.created
    requires: update.kind = message
    ensures: core/BotReceivesMessage(message: update, bot: update.bot)
}

rule TelegramBotAddedRaisesJoin {
    when: TelegramUpdateReceived(update, bot)
    requires: update.kind = message
    requires: update.bot_added
    requires: update.member_count != null
    ensures: extras/BotJoinsChat(chat: update.chat, bot: bot, member_count: update.member_count)
}

-- Discord: the bot is invited to a server. The timeouts are per channel, so the join counts as a join of every text
-- channel the bot can write to, each with the member count of the server. Channels created later get no timeout.
-- No welcome reply is involved.
external entity DiscordGuildJoin {
    channels: Set<core/Chat>
    member_count: Integer
}

rule DiscordGuildJoinRaisesJoin {
    when: DiscordGuildJoinReceived(join, bot)
    ensures: for channel in join.channels:
        extras/BotJoinsChat(chat: channel, bot: bot, member_count: join.member_count)
}

rule DiscordMessageBecomesMessage {
    when: e: DiscordEvent.created
    requires: e.kind = message
    requires: not e.author_is_bot
    requires: e.text.trim != ""
    -- the chat is the channel: private for a direct message, group for the channel of a server
    ensures: core/BotReceivesMessage(message: e, bot: e.bot, chat: DiscordChat(e.channel, e.is_direct))
}

rule DiscordSlashCommandBecomesCommandMessage {
    when: e: DiscordEvent.created
    requires: e.kind = slash_command
    requires: not e.author_is_bot
    requires: e.command_name != null
    -- the interaction is acknowledged invisibly and the acknowledgement deleted at once, replies are plain channel messages;
    -- the message has no id: the interaction is not a message to reply to
    -- the message text is "/" + command name + optional trimmed arguments, in the command syntax of the platform
    ensures: core/BotReceivesMessage(message: e, bot: e.bot, text: SlashCommandText(e.command_name, e.arguments),
                                     chat: DiscordChat(e.channel, e.is_direct))
}

-- IRC limitation (intended): no message ids and no message times, so dedup and the older-message filter never apply
rule IrcLineBecomesMessage {
    when: e: IrcEvent.created
    -- colour and format codes are stripped; the bot's own echo, empty lines and senders over the rate limit are ignored
    -- IRC has no message ids (no deduplication) and no message times (sent_at is the receive time)
    -- the code compares with the nick the connection actually has, which a server can change from bot.nick (intended)
    requires: e.sender.lower != e.bot.nick.lower
    -- the empty check is made after the colour and format codes are stripped
    requires: e.text.trim != ""
    requires: not IrcSenderOverLimit(sender: e.sender)
    -- the chat is the channel, or the sender for a private message (channel = null), compared in lower case
    ensures: core/BotReceivesMessage(message: e, bot: e.bot, chat: IrcChat(e.channel ?? e.sender, e.channel = null))
}

-- fixed window per sender, over the limit the line gets no reply (an info log line is written)
rule IrcSenderOverRateLimitIgnored {
    when: e: IrcEvent.created
    requires: IrcSenderOverLimit(sender: e.sender)
    ensures: IrcLineDropped(sender: e.sender)
}

rule DiscordRegistersSlashCommands {
    when: c: DiscordConnection.created
    -- one slash command per command reply that has English instructions, lowercase 1-32 chars [a-z0-9_-],
    -- (any Unicode letter or digit is accepted), the description is cut to 100 characters with an ellipsis,
    -- deduplicated, first config.discord_max_slash_commands kept, replacing the bot's command set;
    -- a registration failure is logged and the bot keeps running
    ensures: SlashCommandsRegistered(bot: c.bot)
}

------------------------------------------------------------
-- Outbound
------------------------------------------------------------

rule TelegramSendsText {
    when: core/Reply.sent(chat, reply)
    requires: reply.delivery = text
    -- quotes the triggering message when asked and it has an id
    ensures: SentMessage.created(chat: chat, time_to_live: reply.time_to_live, sent_at: now, deleted: false)
}

rule SentMessageExpires {
    when: m: SentMessage.sent_at + m.time_to_live <= now
    requires: m.time_to_live != null
    requires: not m.deleted
    ensures: m.deleted = true
}

-- sources are tried in order (stored platform file ids first, then the downloadable file); the id that worked is cached
-- a reply value the platform cannot send (stickers or buttons on Discord, other unsupported kinds on Telegram) sends
-- nothing and only logs a warning (intended)
-- while a file is sent the chat shows the action matching its kind (upload_voice, upload_photo, upload_video,
-- upload_document for gifs and documents, choose_sticker for stickers)
rule SendMediaFile {
    when: core/Reply.sent(chat, reply)
    requires: reply.delivery = media_file
    ensures: MediaDelivered(chat: chat)
}

rule MediaSendFailureNotified {
    when: send: MediaSend.failed = true
    -- the other replies of the same request are unaffected; missing files and missing chat rights are only logged
    ensures: core/OperatorsNotified(bot: send.bot, reason: media_error)
}

rule SendPagedListAsKeyboard {
    when: core/Reply.sent(chat, reply)
    requires: reply.delivery = paged_list
    ensures: InlineKeyboard.created(message: SentMessage.created(chat: chat, time_to_live: null, sent_at: now, deleted: false),
                                    page: 0, item_count: reply.item_count)
}

-- Telegram only, handled outside the engine on purpose: a press answers the bot's own message, so no dedup, age,
-- timeout or forward filter applies and there is no post computation
rule CallbackPagesKeyboard {
    when: press: CallbackPress.created
    -- the buttons are offered only when has_prev / has_next
    requires: (press.kind = previous_page and press.keyboard.has_prev) or (press.kind = next_page and press.keyboard.has_next)
    ensures: press.keyboard.page = if press.kind = next_page: press.keyboard.page + 1 else: press.keyboard.page - 1
}

-- known defect: a press on a stale button is not rejected: previous stops at the first page, but next past the last
-- page shows an empty page
rule CallbackOnStaleButton {
    when: press: CallbackPress.created
    requires: (press.kind = previous_page and not press.keyboard.has_prev) or (press.kind = next_page and not press.keyboard.has_next)
    ensures: press.keyboard.page = if press.kind = next_page: press.keyboard.page + 1 else: 0
}

rule CallbackDeliversMedia {
    when: press: CallbackPress.created
    requires: press.kind = media
    ensures: press.keyboard.message.deleted = true
}

rule CallbackDeliversShow {
    when: press: CallbackPress.created
    requires: press.kind = show
    ensures: press.keyboard.message.deleted = true
}

-- Discord: text and markdown sent as messages, quoting the triggering message, deleted after their time to live (empty sends nothing); media urls tried in order, a file over the upload
-- limit is sent as its link; markdown files are sent in chunks of 2000 characters; other reply kinds send nothing.
-- IRC: all replies of a request form one logical reply, markdown becomes plain text, text is split on line breaks and each
-- line cut at 400 characters and bytes, capped at irc_max_lines_per_reply ("(K more lines not shown)"), paced by the send delay.
rule IrcSendsReply {
    when: core/Reply.sent(chat, reply)
    ensures: IrcLinesSent(chat: chat)
}

rule IrcReconnects {
    when: c: IrcConnection.lost = true
    -- the delay doubles on each failed attempt up to the maximum, the attempt count resets on every successful registration,
    -- channels are joined again on registration
    ensures: ReconnectScheduled(bot: c.bot)
}

-- inline keyboards exist only where the platform supports buttons
invariant KeyboardsOnlyWhereSupported {
    for k in InlineKeyboards:
        for a in PlatformAdapters:
            a.platform = k.message.chat.platform implies a.capabilities.supports_buttons
}

open question "Media or Show delivery deletes the keyboard message, paging edits it in place: intended?"
open question "An unparsable callback is treated as a media file named by the raw data: intended fallback or accident?"
open question "Text, rich-text and keyboard send failures are swallowed, only media failures reach operators: report them too?"
open question "Is quoting the triggering message a domain requirement or a platform nicety?"
open question "Discord with the message-content intent off: only slash commands work: intended default?"
open question "IRC rate limit is a fixed window (up to 2N across a window edge) with no reply to the user: intended? Should the rate limit and line cap be platform-agnostic anti-flood rules?"
