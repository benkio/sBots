-- allium: 3
-- sBots: the observable behaviour of the bots, platform agnostic.
-- Seeded from docs/bot-logic-overview.md. Code: modules/chatCore (BotEngine, MessageMatches, ReplyBundle,
-- Filtering*, DataEntry). Behaviour changes land in this spec in the same PR.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- created by the platform adapters (platforms.allium) from the inbound events
entity Chat {
    platform: Platform
    is_private: Boolean   -- a one-to-one chat (Telegram private chat, Discord DM)
}

actor Operator {
    -- runs data entry and the catalogue job, reads the ops chat, the health check and the dashboard
    identified_by: Operator where true
}

entity Message {
    chat: Chat
    id: String?           -- absent on some platforms (e.g. IRC)
    text: String?
    caption: String?
    sent_at: Timestamp
    is_forward: Boolean
    new_members: Boolean  -- at least one joined member is not this bot
    bot_added: Boolean    -- this bot is among the joined members
    left_member: Boolean
    content: text ?? caption
    -- the first word of the text is a command of the platform's syntax; a caption is never a command
    is_command: Boolean
    -- a file request of the platform's syntax in the text, addressed to this bot; a caption is never a file request
    is_file_request: Boolean
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Platform { telegram | irc | discord | slack }

enum Matcher { contains_once | contains_all }

enum Outcome { handled | duplicate | timeout | failed }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

enum BotId { abar | orl | cala | mos | pino | rphjb | sgar | xah | ytai }   -- tpl is the scaffold for new bots, not deployed

entity Bot {
    id: BotId
    name: String
    nick: String                      -- IRC nick derived from the name
    engine: BotEngine
    media: MediaFile with bot = this
    message_replies: ReplyBundleMessage with bot = this
    command_replies: ReplyBundleCommand with bot = this
    platforms: Set<Platform>
}

entity BotEngine {
    bot: Bot
    -- the trigger files (list of triggers, instructions) add fixed commands to the bot's own commands
    fixed_commands: Set<ReplyBundleCommand>
}

-- The reply timeout (/settimeout) belongs to the pair (chat, bot). A chat without a row has no timeout.
entity ChatTimeout {
    chat: Chat
    bot: Bot
    reply_timeout: Duration
    last_interaction: Timestamp       -- second precision
    -- the pair is "in timeout" until reply_timeout has passed since the last interaction
    in_timeout: last_interaction + reply_timeout >= now
}

entity ProcessedMessage {
    chat: Chat
    bot: Bot
    message_id: String
    processed_at: Timestamp
}

-- A media file of a bot's catalogue (built by data entry, loaded by the catalogue job). The sticker kind is Telegram
-- only: the other adapters never send it (their paged lists leave it out too).
entity MediaFile {
    bot: Bot
    name: String                      -- prefixed with the bot id
    kind: mp3 | gif | photo | video | document | sticker | markdown
    kinds: Set<String>                -- topic tags used by the media-by-kind commands
    sources: List<String>
    platform_file_ids: Set<String>    -- cached per platform, tried before the downloadable file
    send_count: Integer               -- grows each time the file is sent to a chat
}

entity ReplyBundleMessage {
    bot: Bot
    trigger: Trigger
    matcher: Matcher
    reply: Reply
}

entity ReplyBundleCommand {
    bot: Bot
    command: String
    reply: Reply
}

-- A trigger decides when a message selects a reply bundle.
variant TextTrigger : Trigger { values: Set<String> }   -- string (substring) or regex values, matched on lower case text
variant MessageLengthTrigger : Trigger { length: Integer }
variant NewMemberTrigger : Trigger
variant LeftMemberTrigger : Trigger
variant BotAddedTrigger : Trigger   -- the bot itself joined a group; bundles are data in the replies, like NewMemberTrigger

entity Trigger {
    kind: TextTrigger | MessageLengthTrigger | NewMemberTrigger | BotAddedTrigger | LeftMemberTrigger
    -- a selection among several matching bundles prefers the highest trigger in Trigger's ordering
}

-- A reply is plain (random value from the bundle) or effectful (computed at reply time, e.g. media by kind).
entity Reply {
    kind: plain | effectful
    media: Set<MediaFile>             -- the media files fetched to send the reply (none for a text reply)
    delivery: text | media_file | paged_list   -- how a platform adapter has to deliver it
    time_to_live: Duration?           -- a text reply is deleted after it, when set
    item_count: Integer?              -- the items of a paged_list
    media_kind: String?               -- the kind asked by a media-by-kind reply
}

entity Request {
    message: Message
    bot: Bot
    started_at: Timestamp
    outcome: Outcome?
}

entity DataEntryRun {
    bot: Bot
    inputs: List<String>
    status: in_progress | done | failed

    transitions status {
        in_progress -> done
        terminal: done, failed
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- SBotConfig.requestProcessingTimeout; None disables it
    request_processing_timeout: Duration? = 10.seconds
    -- FilteringOlder.olderThreshold
    older_message_threshold: Duration = 5.minutes
    -- SBotConfig.disableForward / ignoreMessagePrefix, per bot
    disable_forward: Boolean = true
    ignore_message_prefix: String? = "!"
    -- SBotConfig.messageTimeToLive: command replies are deleted after this, only where the platform can delete
    reply_time_to_live: Duration? = 10.seconds
    processed_message_retention: Duration = 24.hours
    processed_message_cleanup_interval: Duration = 1.hour
    -- SBotConfig.pagedListTextModeExpiry/pagedListTextModeMaxChats: the store of the text mode of the platforms
    -- without buttons (the engine-extras PagedListTextStoreEntry): the entries expire paged_list_text_mode_expiry
    -- after they were saved and the store keeps at most paged_list_text_mode_max_chats chats (the keys of the
    -- application.conf of the bot's namespace)
    paged_list_text_mode_expiry: Duration = 10.minutes
    paged_list_text_mode_max_chats: Integer = 100
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Request lifecycle -------------------------------------------------

rule BotReceivesNewMessage {
    when: BotReceivesMessage(message, bot)

    requires: message.id = null or not exists ProcessedMessage{chat: message.chat, bot: bot, message_id: message.id}

    ensures:
        let request = Request.created(message: message, bot: bot, started_at: now)
        if message.id != null: ProcessedMessage.created(chat: message.chat, bot: bot, message_id: message.id, processed_at: now)
        RequestIsDispatched(request: request)
}

-- Platforms can deliver a message twice (e.g. Telegram retries an unacknowledged update): reply once.
rule BotSkipsDuplicateMessage {
    when: BotReceivesMessage(message, bot)

    requires: message.id != null
    requires: exists ProcessedMessage{chat: message.chat, bot: bot, message_id: message.id}

    ensures: Request.created(message: message, bot: bot, started_at: now, outcome: duplicate)
}

-- Command dispatch ----------------------------------------------------

rule BotRepliesToCommand {
    when: RequestIsDispatched(request)

    requires: request.message.is_command
    let command_reply = request.bot.engine.command_for(request.message)
    requires: command_reply != null
    requires: command_reply in request.bot.command_replies or command_reply in request.bot.engine.fixed_commands
    -- the message is the command alone or with an input ("/cmd", "/cmd ..."), written with the command_prefix of the
    -- platform ("/" on Telegram and Discord, "!" on IRC). Where the platform has a mention (Telegram only) it can also be
    -- addressed to this bot ("/cmd@botName ..."), when more bots share the chat
    requires: command_invoked(request.message, command_reply.command)

    ensures: Reply.sent(chat: request.message.chat, reply: command_reply.reply)
}

-- Any "/word" is a command, known or not, so an unknown command gets no reply. The command is the first of
-- [bot commands ++ fixed commands] invoked as "/cmd", "/cmd ..." or "/cmd@botName ...". Fixed commands: triggerlist,
-- triggersearch, toptwenty, settimeout, gettimeout, instructions. The show commands (searchshow, subscribe, unsubscribe,
-- subscriptions, loadcalendar, showcalendar) are an opt-in group a bot adds itself.

-- Message dispatch via reply bundles ------------------------------------

rule BotRepliesToTextTrigger {
    when: RequestIsDispatched(request)

    -- a command (or a file request) is never also handled as a message
    requires: not request.message.is_command
    requires: not request.message.is_file_request
    let message = request.message
    let bundle = request.bot.engine.best_matching_bundle(message)
    requires: bundle != null
    requires: not (config.disable_forward and message.is_forward)
    requires: now - message.sent_at <= config.older_message_threshold
    -- filteringMatchesMessages: the chat must be out of timeout
    -- the timeout filter applies only to the selected bundle: a chat in timeout gets no reply, with no fallback bundle
    requires: not exists ChatTimeout{chat: message.chat, bot: request.bot, in_timeout: true}

    ensures: Reply.sent(chat: message.chat, reply: bundle.reply)
}

-- Best match: the rank of a TextTrigger is the length of its longest value (a regex value has a declared length);
-- the contains_all rank of a TextTrigger is the sum of the lengths of its values, every value matched. Every other
-- trigger ranks 0. When two bundles are ordered and their matchers differ, each bundle is ranked by its own matcher
-- and the higher rank wins; when the matchers are the same the trigger ordering applies (a TextTrigger by the length
-- of its longest value, every other trigger 0). The highest rank wins, a tie goes to the first bundle in the replies
-- order. The forward and age filters apply before matching, to messages only.

rule BotRepliesToFileRequest {
    when: RequestIsDispatched(request)

    -- a message that is both a command and a file request is handled as a command
    requires: not request.message.is_command
    requires: request.message.is_file_request
    requires: request.message.text != null

    -- the media file named by the request content, sent as a reply to the message
    ensures: Reply.sent(chat: request.message.chat, reply: file_reply(MediaFile{bot: request.bot, name: file_request_name(request.message.text)}))
}

-- After a reply the last interaction is logged: this is what the timeout is measured from. It only updates an existing
-- timeout row. The welcome reply to the bot being added is not an interaction: the automatic timeout is measured from
-- the join.
rule PostComputationLogsInteraction {
    when: RequestIsDispatched(request)

    requires: ReplySentFor(request)
    requires: not request.message.bot_added
    requires: exists ChatTimeout{chat: request.message.chat, bot: request.bot}

    ensures: ChatTimeout{chat: request.message.chat, bot: request.bot}.last_interaction = now
}

-- A failed update leaves the stored timeout untouched: inserting a zero-timeout row would silently disable the chat
-- timeout. The message is still handled and the operators are told.
external entity LastInteractionUpdateAttempt {
    chat: Chat
    bot: Bot
    failed: Boolean
}

rule LastInteractionUpdateFails {
    when: attempt: LastInteractionUpdateAttempt.failed = true

    ensures: OperatorsNotified(bot: attempt.bot, reason: last_interaction_update_failed)
}

-- The duplicate check failing does not stop the message: it is processed and the operators are told.
rule DuplicateCheckFailsOpen {
    when: BotReceivesMessage(message, bot)

    requires: message.id != null
    requires: DuplicateStoreUnavailable()

    ensures: OperatorsNotified(bot: bot, reason: duplicate_check_failed)
    ensures: RequestIsDispatched(request: Request.created(message: message, bot: bot, started_at: now))
}

-- an unexpected error while the request is processed
entity RequestError {
    request: Request
}

rule RequestFails {
    when: error: RequestError.created

    requires: error.request.outcome = null

    ensures: error.request.outcome = failed
}

-- A redelivery after the retention is processed again. The purge runs lazily, at most once per cleanup interval and only
-- when a message is checked, so a redelivery slightly after the retention can still count as a duplicate until then.
rule ProcessedMessageExpires {
    when: pm: ProcessedMessage.processed_at + config.processed_message_retention <= now

    ensures: not exists pm
}

rule RequestIsHandled {
    when: RequestIsDispatched(request)

    ensures: request.outcome = handled
}

rule RequestTimesOut {
    when: request: Request.started_at + config.request_processing_timeout <= now

    requires: config.request_processing_timeout != null
    requires: request.outcome = null

    -- the timeout wraps the duplicate check, the bot logic and the last-interaction update, so a timed-out request also
    -- skips that update; a failed request gets a stats line and no operator notification
    -- in-flight processing is cancelled and the request dropped (no reply), the operators are notified
    ensures:
        request.outcome = timeout
        OperatorsNotified(bot: request.bot, reason: request_timeout)
}

-- Trigger semantics ---------------------------------------------------

-- every message reply bundle of the bot is tried on a message that is neither a command nor a file request
rule BotTriesBundles {
    when: RequestIsDispatched(request)

    requires: not request.message.is_command
    requires: not request.message.is_file_request

    ensures:
        for b in request.bot.message_replies:
            BundleIsMatched(bundle: b, message: request.message)
}

-- BotEngine picks the best matching bundle: each bundle is matched by its trigger, the highest trigger wins.
rule TextTriggerMatches {
    when: BundleIsMatched(bundle, message)

    requires: bundle.trigger.kind = TextTrigger
    requires: message.content != null
    requires: not (config.ignore_message_prefix != null and message.content.starts_with(config.ignore_message_prefix))
    requires: bundle.matcher = contains_once and bundle.trigger.values.any(v => matches(v, lower(message.content)))
        or bundle.matcher = contains_all and bundle.trigger.values.all(v => matches(v, lower(message.content)))

    ensures: BundleMatches(bundle: bundle, message: message)
}

rule MessageLengthTriggerMatches {
    when: BundleIsMatched(bundle, message)

    requires: bundle.trigger.kind = MessageLengthTrigger
    requires: message.content != null
    requires: not (config.ignore_message_prefix != null and message.content.starts_with(config.ignore_message_prefix))
    requires: length(message.content) >= bundle.trigger.length

    ensures: BundleMatches(bundle: bundle, message: message)
}

rule NewMemberTriggerMatches {
    when: BundleIsMatched(bundle, message)

    requires: bundle.trigger.kind = NewMemberTrigger
    requires: message.new_members
    -- the ignore prefix suppresses every trigger kind, member triggers included
    requires: not (config.ignore_message_prefix != null and message.content != null
                   and message.content.starts_with(config.ignore_message_prefix))

    ensures: BundleMatches(bundle: bundle, message: message)
}

-- Sibling of NewMemberTrigger, for the bot itself. A join of the bot alone never matches NewMemberTrigger; a join of
-- the bot together with other members matches both triggers, with no precedence between them.
rule BotAddedTriggerMatches {
    when: BundleIsMatched(bundle, message)

    requires: bundle.trigger.kind = BotAddedTrigger
    requires: message.bot_added
    requires: not (config.ignore_message_prefix != null and message.content != null
                   and message.content.starts_with(config.ignore_message_prefix))

    ensures: BundleMatches(bundle: bundle, message: message)
}

rule LeftMemberTriggerMatches {
    when: BundleIsMatched(bundle, message)

    requires: bundle.trigger.kind = LeftMemberTrigger
    requires: message.left_member
    requires: not (config.ignore_message_prefix != null and message.content != null
                   and message.content.starts_with(config.ignore_message_prefix))

    ensures: BundleMatches(bundle: bundle, message: message)
}

-- Data entry: links -> parse -> list + replies json ----------------------

surface OperatorConsole {
    facing _: Operator

    provides:
        OperatorRunsDataEntry(bot, inputs)
}

-- An operator feeds the data entry with links. Each input is trimmed, then must be one of:
--   is_plain_url(input, bot): an http(s) URL that is a valid URI whose last path segment is the media filename
--     (e.g. a Dropbox share link), the filename being `<bot.id>_<name>` with a non empty name;
--   is_named_url(input, bot): `<bot.id>_<name>=<url>`, split on the first `=`, with a non empty name, a non empty
--     url that is a valid URI, and the filename starting with `<bot.id>_`.
-- A plain url is recognised first (it may itself contain `=` in its query); anything else is a named input.
-- (black box predicates, SBot DataEntry.parseInputLink)
rule DataEntryParsesLinks {
    when: OperatorRunsDataEntry(bot, inputs)

    -- both files must exist and contain valid json arrays (malformed json or a non array is a rejection)
    requires: bot.list_json_exists and bot.replies_json_exists
    requires: bot.list_json_is_array and bot.replies_json_is_array
    requires: inputs.all(i => is_plain_url(i, bot) or is_named_url(i, bot))

    ensures:
        let run = DataEntryRun.created(bot: bot, inputs: inputs, status: in_progress)
        -- the sources (filename, no kinds, mime guessed from the filename) are appended to the bot's media list;
        -- they are grouped by the filename without its extension (gif, markdown and sticker suffixes included),
        -- one reply per group is built with the placeholder trigger text "new data" and the replies are prepended
        -- to the bot's replies (the order of the new replies is unspecified);
        -- a `dl=0` query flag is stored as `dl=1` for Dropbox links only
        -- both files are replaced through a temporary file; if the second replacement fails the first is restored
        MediaListExtended(bot: bot, run: run)
        RepliesExtended(bot: bot, run: run)
}

rule DataEntryFinishes {
    when: run: DataEntryRun.created
    requires: run.status = in_progress
    ensures: run.status = done
}

-- The code reports a rejection as an error and never builds a DataEntryRun; `failed` is the spec's view of it.
-- An empty `inputs` is vacuously valid: the run completes and both files are rewritten with the same content.
rule DataEntryRejectsInvalidInput {
    when: OperatorRunsDataEntry(bot, inputs)

    requires: not bot.list_json_exists or not bot.replies_json_exists
        or not bot.list_json_is_array or not bot.replies_json_is_array
        or inputs.any(i => not (is_plain_url(i, bot) or is_named_url(i, bot)))

    -- nothing is written when an input or a file is invalid, the replies file included
    ensures: DataEntryRun.created(bot: bot, inputs: inputs, status: failed)
}

-- Media delivery -----------------------------------------------------

-- the stored platform file ids are tried first, then the downloadable sources in order; the id that worked is cached
-- in platform_file_ids for the platform. The newest id is first, at most 3 ids are kept per platform, and a platform
-- that does not accept file ids, or an id of another platform, is never tried
rule MediaDeliveryTriesCachedIdsThenSources {
    when: Reply.sent(chat, reply)

    ensures:
        for m in reply.media:
            MediaDeliveryAttempted(media: m, chat: chat, candidates: cached_ids_then_sources(m.platform_file_ids, m.sources))
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- a request comes from a chat on one of the platforms the bot runs on
invariant RequestsOnBotPlatforms {
    for r in Requests:
        r.message.chat.platform in r.bot.platforms
}

-- the IRC nick is derived from the bot name: only the characters a nick allows are kept, a leading digit or "-" is
-- prefixed with "_", and it is cut to 16 characters
invariant BotNickDerivedFromName {
    for b in Bots:
        b.nick = irc_nick(b.name)
}

invariant SendCountNeverNegative {
    for m in MediaFiles:
        m.send_count >= 0
}

invariant ReplyDeliveryDetails {
    for r in Replies:
        r.delivery = paged_list implies r.item_count != null
        r.time_to_live != null implies r.delivery = text
}

-- a media-by-kind reply only picks files of the bot that carry the kind
invariant MediaByKindReplyPicksKind {
    for r in Replies:
        r.media_kind != null implies r.media.all(m => r.media_kind in m.kinds)
}

-- Reply bundle selection must not change while the chat is in timeout (filteringMatchesMessages).
invariant NoMessageReplyInTimeout {
    for r in Replies:
        r.is_message_reply implies not exists ChatTimeout{chat: r.chat, bot: r.bot, in_timeout: true}
}

-- A message is either a command, a file request or a plain message: commands are dispatched by the command
-- logic only, before and instead of the message replies.
invariant CommandsNeverGetMessageReplies {
    for r in Replies:
        r.is_message_reply implies not r.message.is_command
}

-- The message-length trigger fires when the message reaches the threshold (messageText.size >= messageLength).
invariant MessageLengthTriggerFiresAtThreshold {
    for m in BundleMatches:
        m.bundle.trigger.kind = MessageLengthTrigger implies length(m.message.content) >= m.bundle.trigger.length
}

-- A message is processed at most once per chat and bot, as long as it has an id (IRC messages have none), the duplicate
-- check works (if it fails the message is processed anyway) and the id is still retained (old ids are forgotten).
invariant ProcessedOnce {
    for a in ProcessedMessages:
        for b in ProcessedMessages:
            a != b implies not (a.chat = b.chat and a.bot = b.bot and a.message_id = b.message_id)
}

------------------------------------------------------------
-- Scope notes
------------------------------------------------------------

-- Binaries live in operator-managed Dropbox/Mega sync folders outside the repository. Data entry stores only the
-- verified share URLs in the bot files, the catalogue loads those URLs into the DB and bots download the media at
-- send time (see catalogue.allium). Cloud sync, link creation and file-id writeback are operations concerns, not bot
-- behavior specified here.

-- Effectful replies are computed at reply time and delivered through the same platform adaptation as plain replies.
-- The key/callback registry is an implementation detail: the observable results live in bots.allium and the
-- adaptation rules in platforms.allium (IRC is the only implemented text-only platform).
